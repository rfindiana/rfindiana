---
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import ContentWrapper from "@/components/ContentWrapper.astro";
---

<Layout title="Videos">
  <Container>
    <ContentWrapper>
      <h1 class="text-3xl font-bold text-primary mb-8">Videos</h1>

      <div class="space-y-12">
        <div>
          <h2 class="text-2xl font-semibold mb-4 text-primary">
            What is Christian Nationalism?
          </h2>
          <div class="aspect-video mb-4">
            <iframe
              class="w-full h-full rounded-lg"
              src="https://www.youtube.com/embed/5YqQxOc_qbM"
              title="What is Christian Nationalism?"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen></iframe>
          </div>
          <p class="text-lg mb-4">
            Amanda Tyler, Executive Director of BJC (Baptist Joint Committee for
            Religious Liberty), explains what Christian nationalism is and why
            it's a threat to both Christianity and democracy.
          </p>
          <p class="text-lg mb-4">
            This video is part of the Christians Against Christian Nationalism
            campaign, which BJC helps lead. Learn more at <a
              href="https://christiansagainstchristiannationalism.org"
              target="_blank"
              rel="noopener noreferrer"
              class="text-primary hover:underline"
              >ChristiansAgainstChristianNationalism.org</a
            >.
          </p>
        </div>

        <div>
          <h2 class="text-2xl font-semibold mb-4 text-primary">
            The Threat of Christian Nationalism
          </h2>
          <div class="aspect-video mb-4">
            <iframe
              class="w-full h-full rounded-lg"
              src="https://www.youtube.com/embed/HtZWqHGQmp4"
              title="The Threat of Christian Nationalism"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen></iframe>
          </div>
          <p class="text-lg mb-4">
            Amanda Tyler, Executive Director of BJC (Baptist Joint Committee for
            Religious Liberty), explains how Christian nationalism threatens
            both Christianity and democracy.
          </p>
          <p class="text-lg mb-4">
            This video is part of the Christians Against Christian Nationalism
            campaign, which BJC helps lead. Learn more at <a
              href="https://christiansagainstchristiannationalism.org"
              target="_blank"
              rel="noopener noreferrer"
              class="text-primary hover:underline"
              >ChristiansAgainstChristianNationalism.org</a
            >.
          </p>
        </div>

        <div>
          <h2 class="text-2xl font-semibold mb-4 text-primary">
            Christian Nationalism and January 6
          </h2>
          <div class="aspect-video mb-4">
            <iframe
              class="w-full h-full rounded-lg"
              src="https://www.youtube.com/embed/HtZWqHGQmp4"
              title="Christian Nationalism and January 6"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen></iframe>
          </div>
          <p class="text-lg mb-4">
            Amanda Tyler, Executive Director of BJC (Baptist Joint Committee for
            Religious Liberty), explains how Christian nationalism influenced
            the January 6, 2021, attack on the U.S. Capitol.
          </p>
          <p class="text-lg mb-4">
            This video is part of the Christians Against Christian Nationalism
            campaign, which BJC helps lead. Learn more at <a
              href="https://christiansagainstchristiannationalism.org"
              target="_blank"
              rel="noopener noreferrer"
              class="text-primary hover:underline"
              >ChristiansAgainstChristianNationalism.org</a
            >.
          </p>
        </div>
      </div>
    </ContentWrapper>
  </Container>
</Layout>

<style>
  .bg-primary-dark {
    background-color: #1a5c36; /* A slightly darker shade of your primary color */
  }
</style>
