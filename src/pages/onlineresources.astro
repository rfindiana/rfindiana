---
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import PageTitle from "@/components/PageTitle.astro";
import { onlineResources } from "@/data/onlineResources";
---

<Layout title="Online Resources">
  <Container article>
    <PageTitle title="Online Resources" />
    <div class="bg-white rounded-lg shadow-md">
      <div class="overflow-x-auto w-full">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th
                class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"
                >Name</th
              >
              <th
                class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"
                >Website</th
              >
              <th
                class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"
                >Organization's Focus</th
              >
              <th
                class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"
                >Additional Information</th
              >
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            {
              onlineResources.map((resource) => (
                <tr>
                  <td class="px-4 py-2 text-sm text-gray-900">
                    {resource.name}
                  </td>
                  <td class="px-4 py-2 text-sm">
                    <a
                      href={resource.website.url}
                      target="_blank"
                      class="text-primary hover:text-primary-dark underline">
                      {resource.website.text}
                    </a>
                  </td>
                  <td class="px-4 py-2 text-sm" set:html={resource.focus} />
                  <td
                    class="px-4 py-2 text-sm"
                    set:html={resource.additionalInfo}
                  />
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </Container>
</Layout>

<style>
  .bg-primary-dark {
    background-color: #1a5c36;
  }
</style>
