---
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import PageTitle from "@/components/PageTitle.astro";
---

<Layout title="Online Resources">
  <Container article>
    <PageTitle title="Online Resources" />
    <div class="bg-white rounded-lg shadow-md">
      <div class="overflow-x-auto w-full">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th
                class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"
                >Name</th
              >
              <th
                class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"
                >Website</th
              >
              <th
                class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"
                >Organization's Focus</th
              >
              <th
                class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"
                >Additional Information</th
              >
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <tr>
              <td class="px-4 py-2 text-sm text-gray-900"
                >Americans United for Separation of Church and State (AU)</td
              >
              <td class="px-4 py-2 text-sm"
                ><a
                  href="https://www.au.org"
                  target="_blank"
                  class="text-primary hover:text-primary-dark underline"
                  >www.au.org</a
                ></td
              >
              <td class="px-4 py-2 text-sm"
                >A nonpartisan legal, educational and advocacy organization that
                protects the right of everyone to believe as they want.</td
              >
              <td class="px-4 py-2 text-sm"
                >Their Indiana chapter:<br />Hoosiers for Separation of Church
                and State<br />Fort Wayne, Indiana<br /><a
                  href="mailto:hfsocas@uufortwayne.org"
                  class="text-primary hover:text-primary-dark underline"
                  >hfsocas@uufortwayne.org</a
                ></td
              >
            </tr>
            <tr>
              <td class="px-4 py-2 text-sm text-gray-900"
                >Baptist Joint Committee for Religious Liberty (BJC)</td
              >
              <td class="px-4 py-2 text-sm"
                ><a
                  href="https://www.bjconline.org"
                  target="_blank"
                  class="text-primary hover:text-primary-dark underline"
                  >www.bjconline.org</a
                ></td
              >
              <td class="px-4 py-2 text-sm"
                >Advocacy and activism in support of religious liberty including
                extensive legal work.</td
              >
              <td class="px-4 py-2 text-sm"
                >Amanda Tyler, E.D., How to End Christian Nationalism.<br
                />Founding sponsor of Christians Against Christian Nationalism.</td
              >
            </tr>
            <tr>
              <td class="px-4 py-2 text-sm text-gray-900"
                >Baptist News Global</td
              >
              <td class="px-4 py-2 text-sm"
                ><a
                  href="https://www.baptistnews.com"
                  target="_blank"
                  class="text-primary hover:text-primary-dark underline"
                  >www.baptistnews.com</a
                ></td
              >
              <td class="px-4 py-2 text-sm">Daily news and opinion pieces.</td>
              <td class="px-4 py-2 text-sm"
                >Covers well the territory of religious liberty. Other foci
                center on Baptist people and events worldwide.</td
              >
            </tr>
            <tr>
              <td class="px-4 py-2 text-sm text-gray-900"
                >Christians Against Christian Nationalism</td
              >
              <td class="px-4 py-2 text-sm"
                ><a
                  href="https://www.christiansagainstchristiannationalism.org"
                  target="_blank"
                  class="text-primary hover:text-primary-dark underline"
                  >www.christiansagainstchristiannationalism.org</a
                ></td
              >
              <td class="px-4 py-2 text-sm"
                >A grassroots campaign to resist Christian nationalism through
                awareness, advocacy, and local organizing.</td
              >
              <td class="px-4 py-2 text-sm"
                >On landing page click on "Resources" for substantive
                information and guidance.</td
              >
            </tr>
            <tr>
              <td class="px-4 py-2 text-sm text-gray-900">The Convocation</td>
              <td class="px-4 py-2 text-sm"
                ><a
                  href="https://convocation.substack.com/about"
                  target="_blank"
                  class="text-primary hover:text-primary-dark underline"
                  >On Substack and YouTube</a
                ></td
              >
              <td class="px-4 py-2 text-sm"
                >3 historians and a sociologist reflect on national and
                international events related to Christian nationalism and
                religious liberty.</td
              >
              <td class="px-4 py-2 text-sm"
                >Diana Butler Bass<br />Robert Jones<br />Kristin Du Mez<br
                />Jemar Tisby</td
              >
            </tr>
            <tr>
              <td class="px-4 py-2 text-sm text-gray-900">Faithful America</td>
              <td class="px-4 py-2 text-sm"
                ><a
                  href="https://act.faithfulamerica.org"
                  target="_blank"
                  class="text-primary hover:text-primary-dark underline"
                  >https://act.faithfulamerica.org</a
                ></td
              >
              <td class="px-4 py-2 text-sm"
                >An independent, interdenominational Christian organization.
                They are active in many causes, including working against
                Christian nationalism.</td
              >
              <td class="px-4 py-2 text-sm"
                >See especially <a
                  href="https://act.faithfulamerica.org/signup/christian-nationalism-resources/"
                  target="_blank"
                  class="text-primary hover:text-primary-dark underline"
                  >this resource page</a
                > for extensive resources in print and online formats.</td
              >
            </tr>
            <tr>
              <td class="px-4 py-2 text-sm text-gray-900">Vote Common Good</td>
              <td class="px-4 py-2 text-sm"
                ><a
                  href="https://www.votecommongood.com"
                  target="_blank"
                  class="text-primary hover:text-primary-dark underline"
                  >https://www.votecommongood.com</a
                ></td
              >
              <td class="px-4 py-2 text-sm"
                >Vote Common Good is inspiring, energizing, and mobilizing
                people of faith to make the common good their voting criteria.
                VCG trains and supports candidates to connect with Evangelical
                and Catholic voters.</td
              >
              <td class="px-4 py-2 text-sm"
                >This site hosts a video based training program for faith
                communities and leaders, "Confronting Christian Nationalism."<br
                /><a
                  href="https://www.votecommongood.com/confronting-christian-nationalism-curriculum/"
                  target="_blank"
                  class="text-primary hover:text-primary-dark underline"
                  >Confronting Christian Nationalism Curriculum</a
                ></td
              >
            </tr>
            <tr>
              <td class="px-4 py-2 text-sm text-gray-900">Word and Way</td>
              <td class="px-4 py-2 text-sm"
                ><a
                  href="https://publicwitness.wordandway.org"
                  target="_blank"
                  class="text-primary hover:text-primary-dark underline"
                  >publicwitness.wordandway.org</a
                ></td
              >
              <td class="px-4 py-2 text-sm"
                >A Public Witness is a newsletter from Word & Way, a Christian
                media company publishing since 1896. A Public Witness provides
                insights from professional experience in academia, advocacy,
                congregational leadership, and political campaigns. The longform
                journalism published here helps you understand what's missed by
                misleading tweets and headlines.</td
              >
              <td class="px-4 py-2 text-sm"
                >Brian Taylor, co-author of Baptizing America, is
                editor-in-chief.</td
              >
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </Container>
</Layout>

<style>
  .bg-primary-dark {
    background-color: #1a5c36;
  }
</style>
