---
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
---

<Layout title="Books">
  <Container>
    <div class="max-w-4xl mx-auto py-12 px-4">
      <h1 class="text-3xl font-bold text-primary mb-8">Books</h1>

      <div class="bg-white rounded-lg shadow-md overflow-hidden">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th
                scope="col"
                class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                Date
              </th>
              <th
                scope="col"
                class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                Author
              </th>
              <th
                scope="col"
                class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                Title
              </th>
              <th
                scope="col"
                class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                More Info
              </th>
              <th
                scope="col"
                class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                Amazon
              </th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <tr>
              <td class="px-6 py-4 whitespace-nowrap">2024-10</td>
              <td class="px-6 py-4 whitespace-nowrap">Amanda Tyler</td>
              <td class="px-6 py-4 whitespace-nowrap"
                >How to End Christian Nationalism</td
              >
              <td class="px-6 py-4 whitespace-nowrap">
                <a
                  href="https://www.broadleafbooks.com/store/product/"
                  target="_blank"
                  class="text-primary hover:text-primary-dark">More Info</a
                >
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <a
                  href="https://www.amazon.com/"
                  target="_blank"
                  class="text-primary hover:text-primary-dark">Amazon</a
                >
              </td>
            </tr>
            <tr>
              <td class="px-6 py-4 whitespace-nowrap">2024-09</td>
              <td class="px-6 py-4 whitespace-nowrap">Taylor, Matthew D.</td>
              <td class="px-6 py-4 whitespace-nowrap"
                >The Violent Take it by Force</td
              >
              <td class="px-6 py-4 whitespace-nowrap">
                <a
                  href="https://icjs.org/the-violent-take-it-by-force/"
                  target="_blank"
                  class="text-primary hover:text-primary-dark">More Info</a
                >
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <a
                  href="https://www.amazon.com/"
                  target="_blank"
                  class="text-primary hover:text-primary-dark">Amazon</a
                >
              </td>
            </tr>
            <tr>
              <td class="px-6 py-4 whitespace-nowrap">2024-07</td>
              <td class="px-6 py-4 whitespace-nowrap">Strait, Drew J.</td>
              <td class="px-6 py-4 whitespace-nowrap">Strange Worship</td>
              <td class="px-6 py-4 whitespace-nowrap">
                <a
                  href="https://www.drewstrait.com/"
                  target="_blank"
                  class="text-primary hover:text-primary-dark">More Info</a
                >
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <a
                  href="https://www.amazon.com/"
                  target="_blank"
                  class="text-primary hover:text-primary-dark">Amazon</a
                >
              </td>
            </tr>
            <tr>
              <td class="px-6 py-4 whitespace-nowrap">2020-06</td>
              <td class="px-6 py-4 whitespace-nowrap">Kristin Kobes Du Mez</td>
              <td class="px-6 py-4 whitespace-nowrap"
                >Jesus and John Wayne - How White Evangelicals Corrupted a Faith
                and Fractured a Nation</td
              >
              <td class="px-6 py-4 whitespace-nowrap">
                <a
                  href="https://kristindumez.com/books/jesus-and-john-wayne/"
                  target="_blank"
                  class="text-primary hover:text-primary-dark">More Info</a
                >
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <a
                  href="https://www.amazon.com/"
                  target="_blank"
                  class="text-primary hover:text-primary-dark">Amazon</a
                >
              </td>
            </tr>
            <tr>
              <td class="px-6 py-4 whitespace-nowrap">2020-03</td>
              <td class="px-6 py-4 whitespace-nowrap"
                >Andrew L. Whitehead & Samuel L. Perry</td
              >
              <td class="px-6 py-4 whitespace-nowrap"
                >Taking America Back for God: Christian Nationalism in the
                United States</td
              >
              <td class="px-6 py-4 whitespace-nowrap">
                <a
                  href="https://readingreligion.org/9780190057886/"
                  target="_blank"
                  class="text-primary hover:text-primary-dark">More Info</a
                >
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <a
                  href="https://www.amazon.com/"
                  target="_blank"
                  class="text-primary hover:text-primary-dark">Amazon</a
                >
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </Container>
</Layout>

<style>
  .bg-primary-dark {
    background-color: #1a5c36; /* A slightly darker shade of your primary color */
  }
</style>
