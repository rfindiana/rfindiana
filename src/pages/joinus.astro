---
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import PageTitle from "@/components/PageTitle.astro";
---

<Layout title="Join Hoosiers Working For Religious Freedom">
  <Container article>
    <!-- Two-row responsive grid: 80/20 on large screens -->
    <div class="lg:grid lg:grid-cols-[4fr,1fr] lg:gap-12 lg:items-end">
      <!-- Left: Title + CTA (row 1, col 1) -->
      <div class="lg:col-[1]">
        <PageTitle title="Join Hoosiers Working for Religious Freedom" class="!mb-3" />

        <!-- Constant Contact CTA -->
        <div class="mt-1 p-6 bg-white border border-gray-200 rounded-lg shadow-sm">
          <p class="mb-3 text-sm text-gray-800 leading-snug">
            We’ve moved our signup form to Constant Contact.
          </p>
          <a
            href="https://lp.constantcontactpages.com/sl/pRZrU4p?utm_source=site&utm_medium=joinus_page&utm_campaign=signup"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-5 py-3 rounded-md bg-primary text-white font-medium hover:opacity-90 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary"
          >
            Sign up on Constant Contact
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-5 h-5">
              <path fill-rule="evenodd" d="M3 10a1 1 0 011-1h8.586L9.293 5.707a1 1 0 111.414-1.414l5 5a1 1 0 010 1.414l-5 5a1 1 0 11-1.414-1.414L12.586 11H4a1 1 0 01-1-1z" clip-rule="evenodd" />
            </svg>
          </a>
          <p class="mt-3 text-sm text-gray-600">
            The button opens our secure signup in a new tab.
          </p>
        </div>
      </div>

      <!-- Right: Backup Email Option (row 1, col 2) -->
      <aside class="mt-6 lg:mt-0 lg:col-[2]">
        <div class="p-4 bg-yellow-50 border border-yellow-200 rounded-lg">
          <p class="text-sm">
            Having trouble with the form? Please email
            <a
              href="mailto:info@rfindiana.org"
              class="text-primary hover:underline font-medium">
              info@rfindiana.org
            </a>
            with your name and email address to join our list.
          </p>
        </div>
      </aside>

      <!-- Row 2: Notes across full width, two columns at 50% -->
      <section class="mt-5 lg:mt-0 lg:col-span-2">
        <h2 class="text-2xl font-bold text-primary mb-4">Notes</h2>
        <div class="bg-gray-50 rounded-lg p-6">
          <div class="lg:grid lg:grid-cols-2 lg:gap-6">
            <ol class="list-decimal list-inside space-y-4 text-base">
              <li>
                If you want to show your support but don't wish to receive regular
                emails, you can subscribe and then unsubscribe immediately after
                confirming your subscription.
              </li>
              <li>
                We respect your privacy. Your responses — including religious
                affiliation — will be kept confidential. We will never sell your
                information or share it without your permission. Your name or
                details will not be publicly listed unless you explicitly agree.
                You'll only receive updates from Religious Freedom Indiana, and
                you can unsubscribe at any time.
              </li>
            </ol>
            <ol start="3" class="list-decimal list-inside space-y-4 text-base mt-6 lg:mt-0">
              <li>
                In a Zoom call, your name may be visible to others. Please adjust
                your Zoom settings to control what is shared.
              </li>
              <li>
                We also encourage you to subscribe to Christians Against Christian
                Nationalism for their email updates and resources: Subscribe at <a
                  href="https://christiansagainstchristiannationalism.org/subscribe/"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-primary hover:underline font-medium">
                  ChristiansAgainstChristianNationalism.org
                </a>
              </li>
              <li>
                Need to update your preferences later? Email <a
                  href="mailto:info@rfindiana.org"
                  class="text-primary hover:underline">info@rfindiana.org</a
                > with your changes.
              </li>
            </ol>
          </div>
        </div>
      </section>
    </div>
  </Container>
</Layout>
