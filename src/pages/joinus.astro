---
import Layout from "@/layouts/Layout.astro";
---

<Layout title="Join Us">
  <div class="container mx-auto px-4 py-12">
    <h1 class="text-3xl font-bold text-primary mb-6 text-center">
      Join Our Mailing List
    </h1>
    <p class="text-lg text-center mb-8">
      Stay updated with Religious Freedom Indiana. Sign up below!
    </p>

    <div
      class="mailerlite-embed-container max-w-lg mx-auto bg-gray-50 p-6 rounded-lg shadow">
      <p class="text-center text-gray-600 font-medium">
        Your MailerLite Form Will Appear Here
      </p>
    </div>
  </div>
</Layout>
