---
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import PageTitle from "@/components/PageTitle.astro";
import BrevoForm from "@/components/BrevoForm.astro"; // Import the new component
---

<Layout title="Join Hoosiers Working For Religious Freedom">
  <Container article>
    <div class="flex flex-col lg:flex-row lg:gap-12">
      <div class="lg:w-7/12">
        <PageTitle title="Join Hoosiers Working for Religious Freedom" />

        <!-- Replace iframe with BrevoForm component -->
        <BrevoForm />

        <!-- Backup Email Option -->
        <div
          class="mt-8 p-4 bg-yellow-50 border border-yellow-200 rounded-lg">
          <p class="text-sm">
            Having trouble with the form? Please email
            <a
              href="mailto:info@rfindiana.org"
              class="text-primary hover:underline font-medium">
              info@rfindiana.org
            </a>
            with your name and email address to join our list.
          </p>
        </div>
      </div>

      <div class="lg:w-5/12 mt-8 lg:mt-0">
        <h2 class="text-2xl font-bold text-primary mb-4">Notes</h2>
        <div class="bg-gray-50 rounded-lg p-6">
          <ol class="list-decimal list-inside space-y-4 text-base">
            <li>
              If you want to show your support but don't wish to receive regular
              emails, you can subscribe and then unsubscribe immediately after
              confirming your subscription.
            </li>
            <li>
              We respect your privacy. Your responses — including religious
              affiliation — will be kept confidential. We will never sell your
              information or share it without your permission. Your name or
              details will not be publicly listed unless you explicitly agree.
              You'll only receive updates from Religious Freedom Indiana, and
              you can unsubscribe at any time.
            </li>
            <li>
              If you are concerned about security, you might consider a free
              email from <a
                href="https://proton.me/mail"
                target="_blank"
                rel="noopener noreferrer"
                class="text-primary hover:underline font-medium">Proton Mail</a
              >. We use Proton Mail at rfindiana.org to communicate with you. In
              a Zoom call, your name may be visible to others. Please adjust
              your Zoom settings to control what is shared.
            </li>
            <li>
              We also encourage you to subscribe to Christians Against Christian
              Nationalism for their email updates and resources: Subscribe at <a
                href="https://christiansagainstchristiannationalism.org/subscribe/"
                target="_blank"
                rel="noopener noreferrer"
                class="text-primary hover:underline font-medium">
                ChristiansAgainstChristianNationalism.org
              </a>
            </li>
            <li>
              Need to update your preferences later? Email <a
                href="mailto:info@rfindiana.org"
                class="text-primary hover:underline">info@rfindiana.org</a
              > with your changes.
            </li>
          </ol>
        </div>
      </div>
    </div>
  </Container>
</Layout>

<style>
  /* Custom styles for Brevo form container */
  /* These might need adjustment now that it's not an iframe */
  .brevo-form-container {
    /* position: relative; */ /* May not be needed */
    width: 100%;
    height: auto;
    /* min-height: 1000px; */ /* Remove fixed min-height */
    overflow: visible;
  }

  /* Remove iframe specific styles */
  /* #brevo-form-iframe {
    position: relative;
    width: 100%;
    border: none;
    display: block;
  } */
</style>
