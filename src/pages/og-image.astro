---
import "../styles/global.css";
---

<div
  class="relative flex h-[630px] w-[1200px] flex-col items-center justify-center overflow-hidden bg-primary px-20 text-center text-white">
  <div class="absolute inset-x-0 top-0 h-4 bg-crimson"></div>
  <img
    src="/images/Logo Wide.png"
    alt="Religious Freedom Indiana Logo"
    class="mb-12 h-32 w-auto"
  />
  <p class="font-sunborn text-5xl uppercase text-white mb-4">
    Hoosiers Working for Religious Freedom
  </p>
  <p class="font-hussar text-3xl text-white/90">
    Act justly, love mercy, walk humbly
  </p>
  <p class="mt-3 font-hussar text-lg uppercase tracking-[0.3em] text-white/70">
    Micah 6:8
  </p>
</div>
