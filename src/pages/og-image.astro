---
import "../styles/global.css";
---

<div
  class="bg-gradient-to-r from-primary-light/20 to-primary/20 w-[1200px] h-[630px] flex flex-col items-center justify-center text-center">
  <img
    src="/images/logo.svg"
    alt="Religious Freedom Indiana Logo"
    class="h-36 w-auto mb-4"
  />
  <h1 class="text-5xl font-bold text-primary mb-3">
    Religious Freedom Indiana
  </h1>
  <p class="text-2xl text-primary-dark mb-2">
    Hoosiers Working for Religious Freedom
  </p>
  <p class="italic text-xl text-primary-dark/90">
    Act justly, love mercy, walk humbly (Micah 6:8)
  </p>
</div>