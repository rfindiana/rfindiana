---
import Container from "@/components/container.astro";
import Hero from "@/components/hero.astro";
import Layout from "@/layouts/Layout.astro";
import PageTitle from "@/components/PageTitle.astro";
import MembershipGoal from "@/components/membership-goal.astro";
---

<Layout title="Religious Freedom Indiana">
  <Hero />
  <Container article>
    <section>
      <MembershipGoal />
    </section>
  </Container>
</Layout>

<script>
  import Chart from "chart.js/auto";

  function initializeChart() {
    const table = document.getElementById("growthTable") as HTMLTableElement;
    if (!table) return; // Ensure table exists

    const tbody = table.getElementsByTagName("tbody")[0];
    if (!tbody) return; // Ensure tbody exists

    const rows = tbody.getElementsByTagName("tr");

    const labels: string[] = [];
    const data: number[] = [];

    for (let i = 0; i < rows.length; i++) {
      const cells = rows[i].getElementsByTagName("td");
      if (cells.length >= 2) {
        // Ensure cells exist
        labels.push(cells[0].innerText);
        data.push(parseInt(cells[1].innerText));
      }
    }

    const canvas = document.getElementById("growthChart") as HTMLCanvasElement;
    if (!canvas) return; // Ensure canvas exists

    const existingChart = Chart.getChart(canvas);
    if (existingChart) {
      existingChart.destroy(); // Destroy existing chart instance if it exists
    }

    const ctx = canvas.getContext("2d");
    if (ctx) {
      new Chart(ctx, {
        type: "line",
        data: {
          labels: labels,
          datasets: [
            {
              label: "Total Supporters",
              data: data,
              borderColor: "rgb(79, 70, 229)", // primary color
              tension: 0.1,
            },
          ],
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          scales: {
            y: {
              beginAtZero: true,
            },
          },
        },
      });
    }
  }

  // Run on initial page load
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initializeChart);
  } else {
    initializeChart();
  }

  // Run on subsequent Astro page loads
  document.addEventListener("astro:page-load", initializeChart);
</script>
