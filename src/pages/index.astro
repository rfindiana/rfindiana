---
import Container from "@/components/container.astro";
import Hero from "@/components/hero.astro";
import Layout from "@/layouts/Layout.astro";
import PageTitle from "@/components/PageTitle.astro";

// Membership Goal Constants
const currentMembers = 89;
const goal = 100000;
const percentage = ((currentMembers / goal) * 100).toFixed(2);
const lastUpdated = "April 10, 2025";
---

<Layout title="Religious Freedom Indiana">
  <Hero />
  <Container article>
    <section class="pt-8 border-t">
      <PageTitle title="Our Membership Goal" />
      <p class="text-lg text-gray-700 mb-6">
        Our goal is to connect with 100,000 Hoosiers
        <span class="text-sm text-gray-600"
          >(approx. 3.4% of Indiana voters in the 2024 presidential election)</span
        >
        dedicated to protecting true religious freedom. Here's our progress:
      </p>

      <div class="bg-gray-50 rounded-lg p-6 mb-8">
        <h3 class="text-xl font-medium text-gray-800 mb-4">
          Current Progress:
        </h3>
        <div
          class="flex flex-col sm:flex-row justify-between items-baseline mb-4">
          <span class="text-lg font-semibold text-primary">
            {currentMembers.toLocaleString()} / {goal.toLocaleString()} Total Supporters
          </span>
          <span class="text-sm font-medium text-gray-600">
            {percentage}% towards our goal!
          </span>
        </div>
        <div class="w-full bg-gray-200 rounded-full h-4 overflow-hidden">
          <div
            class="bg-primary h-4 rounded-full transition-all duration-500"
            style={`width: ${percentage}%`}>
          </div>
        </div>
        <p class="text-xs text-gray-500 mt-2">Last updated: {lastUpdated}</p>
        <p class="text-sm text-gray-600 mt-4">
          Note: If you want to show your support but don't wish to receive
          regular emails, you can subscribe and then unsubscribe immediately
          after confirming your subscription.
        </p>
      </div>

      <div>
        <h3 class="text-xl font-medium text-gray-800 mb-4">
          Growth History:
        </h3>
        <div class="mb-8">
          <canvas id="growthChart"></canvas>
        </div>
        <div class="overflow-x-auto w-full">
          <table id="growthTable" class="min-w-full divide-y divide-gray-200 text-sm">
            <thead class="bg-gray-50">
              <tr>
                <th
                  scope="col"
                  class="px-4 py-2 text-left font-medium text-gray-500 uppercase tracking-wider"
                  >Date</th
                >
                <th
                  scope="col"
                  class="px-4 py-2 text-left font-medium text-gray-500 uppercase tracking-wider"
                  >Total Supporters</th
                >
              </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
              <tr>
                <td class="px-4 py-2 whitespace-nowrap text-gray-900"
                  >March 27, 2025</td
                >
                <td class="px-4 py-2 whitespace-nowrap text-gray-900">28</td>
              </tr>
              <tr>
                <td class="px-4 py-2 whitespace-nowrap text-gray-900"
                  >April 10, 2025</td
                >
                <td class="px-4 py-2 whitespace-nowrap text-gray-900">69</td>
              </tr>
              <tr>
                <td class="px-4 py-2 whitespace-nowrap text-gray-900"
                  >May 10, 2025</td
                >
                <td class="px-4 py-2 whitespace-nowrap text-gray-900">89</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>
  </Container>
</Layout>

<script>
  import Chart from 'chart.js/auto';

  const table = document.getElementById('growthTable') as HTMLTableElement;
  const tbody = table.getElementsByTagName('tbody')[0];
  const rows = tbody.getElementsByTagName('tr');

  const labels: string[] = [];
  const data: number[] = [];

  for (let i = 0; i < rows.length; i++) {
    const cells = rows[i].getElementsByTagName('td');
    labels.push(cells[0].innerText);
    data.push(parseInt(cells[1].innerText));
  }

  const ctx = (document.getElementById('growthChart') as HTMLCanvasElement).getContext('2d');
  if (ctx) {
    new Chart(ctx, {
      type: 'line',
      data: {
        labels: labels,
        datasets: [{
          label: 'Total Supporters',
          data: data,
          borderColor: 'rgb(79, 70, 229)', // primary color
          tension: 0.1
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        scales: {
          y: {
            beginAtZero: true
          }
        }
      }
    });
  }
</script>
