---
import "../styles/global.css";
---

<div
  class="bg-gradient-to-r from-primary-light/20 to-primary/20 w-[1200px] h-[630px] flex flex-col items-center justify-center text-center">
  <div class="flex items-center gap-0.5">
    <img
      src="/images/favicon.png"
      alt="Religious Freedom Indiana Favicon"
      class="h-64 w-64 rounded-full"
    />
    <div class="text-left">
      <h1 class="text-8xl font-bold text-primary">Religious Freedom</h1>
      <h2 class="text-8xl font-bold text-primary">Indiana</h2>
    </div>
  </div>
  <p class="tagline text-4xl md:text-5xl text-primary-dark">
    Hoosiers Working for Religious Freedom
  </p>
  <p
    class="micah-quote-hero italic text-3xl md:text-4xl text-primary-dark/90 mt-2">
    Act justly, love mercy, walk humbly (Micah 6:8)
  </p>
</div>