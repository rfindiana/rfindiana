---
import "../styles/global.css";
---

<div
  class="bg-gradient-to-r from-primary-light/20 to-primary/20 w-[1640px] h-[856px] flex flex-col items-center justify-center text-center">
  <div class="flex items-center gap-4">
    <img
      src="/images/favicon.png"
      alt="Religious Freedom Indiana Favicon"
      class="h-48 w-48 rounded-full"
    />
    <div class="text-left">
      <h1 class="text-6xl font-bold text-primary">Religious Freedom</h1>
      <h2 class="text-6xl font-bold text-primary">Indiana</h2>
    </div>
  </div>
  <p class="tagline text-2xl md:text-3xl text-primary-dark">
    Hoosiers Working for Religious Freedom
  </p>
  <p
    class="micah-quote-hero italic text-xl md:text-2xl text-primary-dark/90 mt-2">
    Act justly, love mercy, walk humbly (Micah 6:8)
  </p>
</div>