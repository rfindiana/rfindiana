---
import "../styles/global.css";
---

<div
  class="bg-gradient-to-r from-primary-light/20 to-primary/20 w-[1640px] h-[856px] flex flex-col items-center justify-center text-center">
  <img
    src="/images/logo.svg"
    alt="Religious Freedom Indiana Logo"
    class="h-48 w-auto mb-6"
  />
  <h1 class="text-6xl font-bold text-primary mb-4">
    Religious Freedom Indiana
  </h1>
  <p class="text-3xl text-primary-dark mb-2">
    Hoosiers Working for Religious Freedom
  </p>
  <p class="italic text-2xl text-primary-dark/90">
    Act justly, love mercy, walk humbly (Micah 6:8)
  </p>
</div>