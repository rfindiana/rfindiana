---
import "../styles/global.css";
---

<div
  class="relative flex h-[856px] w-[1640px] flex-col items-center justify-center overflow-hidden bg-primary px-24 text-center text-white">
  <div class="absolute inset-x-0 top-0 h-5 bg-crimson"></div>
  <img
    src="/images/Logo Wide.png"
    alt="Religious Freedom Indiana Logo"
    class="mb-16 h-44 w-auto"
  />
  <p class="mb-5 font-sunborn text-6xl uppercase text-white">
    Hoosiers Working for Religious Freedom
  </p>
  <p class="font-hussar text-4xl text-white/90">
    Act justly, love mercy, walk humbly
  </p>
  <p class="mt-4 font-hussar text-xl uppercase tracking-[0.3em] text-white/70">
    Micah 6:8
  </p>
</div>
