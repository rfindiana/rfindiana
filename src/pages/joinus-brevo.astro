---
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import PageTitle from "@/components/PageTitle.astro";
---

<Layout title="Manage Your Profile">
  <Container article>
    <div class="flex flex-col lg:flex-row lg:gap-12">
      <div class="lg:w-7/12">
        <PageTitle title="Manage Your Profile" />
        <form id="profile-form" method="POST" action="/api/manage-profile" class="space-y-4">
          <div>
            <label for="email" class="block text-sm font-medium text-gray-700">Email</label>
            <input id="email" name="email" type="email" required class="mt-1 block w-full border-gray-300 rounded-md shadow-sm" />
          </div>

          <div>
            <label for="first-name" class="block text-sm font-medium text-gray-700">First Name</label>
            <input id="first-name" name="firstName" type="text" required class="mt-1 block w-full border-gray-300 rounded-md shadow-sm" />
          </div>

          <div>
            <label for="last-name" class="block text-sm font-medium text-gray-700">Last Name</label>
            <input id="last-name" name="lastName" type="text" required class="mt-1 block w-full border-gray-300 rounded-md shadow-sm" />
          </div>

          <div>
            <label for="city" class="block text-sm font-medium text-gray-700">City (Optional)</label>
            <input id="city" name="city" type="text" class="mt-1 block w-full border-gray-300 rounded-md shadow-sm" />
          </div>

          <div>
            <label for="state" class="block text-sm font-medium text-gray-700">State (Optional)</label>
            <input id="state" name="state" type="text" class="mt-1 block w-full border-gray-300 rounded-md shadow-sm" />
          </div>

          <div>
            <label for="zip" class="block text-sm font-medium text-gray-700">Zip (Optional)</label>
            <input id="zip" name="zip" type="text" class="mt-1 block w-full border-gray-300 rounded-md shadow-sm" />
          </div>

          <div>
            <label for="phone" class="block text-sm font-medium text-gray-700">Phone (Optional)</label>
            <input id="phone" name="phone" type="tel" class="mt-1 block w-full border-gray-300 rounded-md shadow-sm" />
          </div>

          <div>
            <label for="religious-group" class="block text-sm font-medium text-gray-700">Religious Group (Optional)</label>
            <input id="religious-group" name="religiousGroup" type="text" class="mt-1 block w-full border-gray-300 rounded-md shadow-sm" />
          </div>

          <div>
            <label for="email-frequency" class="block text-sm font-medium text-gray-700">Email Frequency (Optional)</label>
            <select id="email-frequency" name="emailFrequency" class="mt-1 block w-full border-gray-300 rounded-md shadow-sm">
              <option value="daily">Daily</option>
              <option value="weekly">Weekly</option>
              <option value="monthly">Monthly</option>
            </select>
          </div>

          <button type="submit" class="px-4 py-2 bg-primary text-white rounded-md">Save Profile</button>
        </form>
      </div>

      <div class="lg:w-5/12 mt-8 lg:mt-0">
        <h2 class="text-2xl font-bold text-primary mb-4">Notes</h2>
        <div class="bg-gray-50 rounded-lg p-6">
          <ol class="list-decimal list-inside space-y-4 text-base">
            <li>
              If you want to show your support but don't wish to receive regular
              emails, you can subscribe and then unsubscribe immediately after
              confirming your subscription.
            </li>
            <li>
              We respect your privacy. Your responses — including religious
              affiliation — will be kept confidential. We will never sell your
              information or share it without your permission. Your name or
              details will not be publicly listed unless you explicitly agree.
              You'll only receive updates from Religious Freedom Indiana, and
              you can unsubscribe at any time.
            </li>
            <li>
              If you are concerned about security, you might consider a free
              email from <a
                href="https://proton.me/mail"
                target="_blank"
                rel="noopener noreferrer"
                class="text-primary hover:underline font-medium">Proton Mail</a
              >. We use Proton Mail at rfindiana.org to communicate with you.
            </li>
            <li>
              We also encourage you to subscribe to Christians Against Christian
              Nationalism for their email updates and resources: Subscribe at <a
                href="https://christiansagainstchristiannationalism.org/subscribe/"
                target="_blank"
                rel="noopener noreferrer"
                class="text-primary hover:underline font-medium">
                ChristiansAgainstChristianNationalism.org
              </a>
            </li>
          </ol>
        </div>
      </div>
    </div>
  </Container>
</Layout>
