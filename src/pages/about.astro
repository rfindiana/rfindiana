---
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import PageTitle from "@/components/PageTitle.astro";
import { getEntry, render } from "astro:content";

const aboutEntry = await getEntry("pages", "about");
const { Content } = await render(aboutEntry);
---

<Layout title="About Us - Religious Freedom Indiana">
  <Container article>
    <PageTitle title="About Us" />
    <div class="mt-2 w-full text-text prose prose-lg max-w-none">
      <Content />
    </div>
  </Container>
</Layout>

<style>
  /* Styles specific to this page can go here */
</style>
