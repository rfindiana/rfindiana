---
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import PageTitle from "@/components/PageTitle.astro";
import { getCollection, render } from "astro:content";

const allOrganizations = await getCollection("organizations");
const sorted = allOrganizations.sort((a, b) => a.data.sortOrder - b.data.sortOrder);
const rendered = await Promise.all(
  sorted.map(async (org) => ({
    data: org.data,
    Content: (await render(org)).Content,
  }))
);
const nationalOrganizations = rendered.filter((org) => org.data.category === "national");
const statewideOrganizations = rendered.filter((org) => org.data.category === "statewide");
---

<Layout title="Network">
  <Container article>
    <PageTitle title="Featured Organizations" />
    <div
      class="max-w-4xl text-sm text-gray-700 bg-yellow-50 border border-yellow-200 rounded p-4 mb-6 italic">
      <strong class="font-semibold">Note:</strong>
      The organizations and groups featured here have interests or missions that
      often overlap with ours, and we hope these connections are useful to our visitors.
      Inclusion here does not imply endorsement by Religious Freedom Indiana. As
      a 501(c)(3) nonprofit, we remain strictly non-partisan, even when sharing information
      from groups with a variety of perspectives.
    </div>
    <p class="text-lg mb-4">
      Religious Freedom Indiana believes in the power of working together. By
      building a diverse network of like-minded organizations — from national
      voices to local initiatives — we strengthen our collective efforts to
      protect genuine religious freedom for all. Below are some of the allies,
      collaborators, and organizations we've connected with as we work together
      to safeguard faith, equity, and democracy in Indiana and beyond.
    </p>
    <p class="text-lg mb-8">
      We encourage our members to consider subscribing to these organizations
      and to review their resources.
    </p>

    <h2 class="text-2xl font-semibold text-primary mb-6">National</h2>

    <div class="bg-white rounded-lg shadow-md overflow-hidden mb-8">
      <div class="overflow-x-auto w-full">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th
                scope="col"
                class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                Organization
              </th>
              <th
                scope="col"
                class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                Description
              </th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            {nationalOrganizations.map(({ data, Content }) => (
              <tr>
                <td class="px-4 py-4 w-40 align-middle">
                  <a href={data.websiteUrl} target="_blank" rel="noopener noreferrer">
                    <img
                      src={data.logoImage}
                      alt={`${data.title} Logo`}
                      class="h-16 w-auto object-contain align-middle"
                    />
                  </a>
                </td>
                <td class="px-4 py-4 align-top">
                  <a
                    href={data.websiteUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-lg font-medium text-primary hover:text-primary-dark underline">
                    {data.title}
                  </a>
                  <div class="mt-2 text-gray-600 prose prose-sm max-w-none">
                    <Content />
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <h2 class="text-2xl font-semibold text-primary mb-6">Statewide</h2>
    <div class="bg-white rounded-lg shadow-md overflow-hidden mb-8">
      <div class="overflow-x-auto w-full">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th
                class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"
                >Organization</th
              >
              <th
                class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"
                >Description</th
              >
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            {statewideOrganizations.map(({ data, Content }) => (
              <tr>
                <td class="px-4 py-4 w-40 align-middle">
                  <a href={data.websiteUrl} target="_blank" rel="noopener noreferrer">
                    <img
                      src={data.logoImage}
                      alt={`${data.title} Logo`}
                      class="h-16 w-auto object-contain align-middle"
                    />
                  </a>
                </td>
                <td class="px-4 py-4 align-top">
                  <a
                    href={data.websiteUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-lg font-medium text-primary hover:text-primary-dark underline"
                    >{data.title}</a
                  >
                  <div class="mt-2 text-gray-600 prose prose-sm max-w-none">
                    <Content />
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <h2 class="text-2xl font-semibold text-primary mb-6">Local</h2>
    <p class="text-lg mb-4 italic text-gray-600">
      Coming soon — local churches, nonprofits, and civic groups who share our
      mission.
    </p>
  </Container>
</Layout>

<style>
  .bg-primary-dark {
    background-color: #1a5c36; /* A slightly darker shade of your primary color */
  }
</style>
