---
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import ContentWrapper from "@/components/ContentWrapper.astro";
---

<Layout title="Network">
  <Container>
    <ContentWrapper>
      <h1 class="text-3xl font-bold text-primary mb-8">Network</h1>

      <div class="space-y-12">
        <section>
          <h2 class="text-2xl font-semibold mb-4 text-primary">
            National Organizations
          </h2>
          <div class="space-y-6">
            <div class="bg-white rounded-lg shadow-md p-6">
              <h3 class="text-xl font-semibold mb-3 text-primary">
                Christians Against Christian Nationalism
              </h3>
              <p class="text-lg mb-4">
                A campaign bringing together Christians to oppose Christian
                nationalism and its threat to both faith and democracy.
              </p>
              <div class="flex items-center space-x-4">
                <a
                  href="https://www.christiansagainstchristiannationalism.org/"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center text-primary hover:text-primary-dark">
                  Visit Website
                  <svg
                    class="w-4 h-4 ml-1"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    ><path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                    ></path></svg
                  >
                </a>
              </div>
            </div>

            <div class="bg-white rounded-lg shadow-md p-6">
              <h3 class="text-xl font-semibold mb-3 text-primary">
                Baptist Joint Committee for Religious Liberty (BJC)
              </h3>
              <p class="text-lg mb-4">
                A national organization working to defend and extend religious
                liberty for all people.
              </p>
              <div class="flex items-center space-x-4">
                <a
                  href="https://bjconline.org/"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center text-primary hover:text-primary-dark">
                  Visit Website
                  <svg
                    class="w-4 h-4 ml-1"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    ><path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                    ></path></svg
                  >
                </a>
              </div>
            </div>
          </div>
        </section>

        <section>
          <h2 class="text-2xl font-semibold mb-4 text-primary">
            State Organizations
          </h2>
          <div class="bg-gray-50 rounded-lg p-6">
            <p class="text-lg italic text-gray-600">
              We are currently building relationships with organizations across
              Indiana. Check back soon for updates.
            </p>
          </div>
        </section>

        <section>
          <h2 class="text-2xl font-semibold mb-4 text-primary">
            Local Organizations
          </h2>
          <div class="bg-gray-50 rounded-lg p-6">
            <p class="text-lg italic text-gray-600">
              We are actively connecting with local churches, nonprofits, and
              civic groups who share our mission. Check back soon for updates.
            </p>
          </div>
        </section>
      </div>
    </ContentWrapper>
  </Container>
</Layout>

<style>
  .bg-primary-dark {
    background-color: #1a5c36; /* A slightly darker shade of your primary color */
  }
</style>
