---
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import PageTitle from "@/components/PageTitle.astro";
import { getCollection } from "astro:content";

const allDocs = await getCollection("documents");
const docs = allDocs.sort((a, b) => a.data.sortOrder - b.data.sortOrder);
---

<Layout title="Documents">
  <Container article>
    <PageTitle title="Documents" />

    <div class="bg-white rounded-lg shadow-md">
      <div class="overflow-x-auto w-full">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th
                scope="col"
                class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider w-48">
                Title
              </th>
              <th
                scope="col"
                class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                Description
              </th>
              <th
                scope="col"
                class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                Preview (Click to Download)
              </th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            {docs.map((doc) => (
              <tr>
                <td class="px-4 py-2 whitespace-nowrap">
                  <div class="text-sm font-medium text-gray-900 whitespace-normal">
                    {doc.data.title}
                  </div>
                </td>
                <td class="px-4 py-2">
                  <div class="text-sm text-gray-700 whitespace-normal">
                    {doc.data.description}
                  </div>
                </td>
                <td class="px-4 py-2">
                  <a
                    href={doc.data.fileLink}
                    target="_blank"
                    class="block hover:opacity-75 transition-opacity">
                    <img
                      src={doc.data.thumbnailImage}
                      alt={`Preview of ${doc.data.title} - Click to Download`}
                      class="w-20 h-auto object-contain rounded shadow-sm"
                    />
                  </a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </Container>
</Layout>

<style>
  .bg-primary-dark {
    background-color: #1a5c36;
  }
</style>
