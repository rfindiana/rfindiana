---
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
---

<Layout title="Documents">
  <Container>
    <article class="max-w-3xl mx-auto py-8 px-4 sm:px-6 lg:px-8">
      <h1 class="text-3xl font-bold text-primary mb-8">Documents</h1>

      <div class="bg-white rounded-lg shadow-md overflow-hidden">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th
                scope="col"
                class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider w-48">
                Title
              </th>
              <th
                scope="col"
                class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                Description
              </th>
              <th
                scope="col"
                class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                Preview (Click to Download)
              </th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <tr>
              <td class="px-6 py-4 whitespace-nowrap">
                <div
                  class="text-sm font-medium text-gray-900 whitespace-normal">
                  What is Christian Nationalism?
                </div>
              </td>
              <td class="px-6 py-4">
                <div class="text-sm text-gray-700">
                  An introduction to Christian nationalism and its impact on
                  religious freedom.
                </div>
              </td>
              <td class="px-6 py-4">
                <a
                  href="/docs/what+is+christian+nationalism.pdf"
                  target="_blank"
                  class="block hover:opacity-75 transition-opacity">
                  <img
                    src="/docs/thumbnails/what-is-christian-nationalism-thumb.jpg"
                    alt="Preview of What is Christian Nationalism - Click to Download PDF"
                    class="w-20 h-auto object-contain rounded shadow-sm"
                  />
                </a>
              </td>
            </tr>
            <tr>
              <td class="px-6 py-4 whitespace-nowrap">
                <div
                  class="text-sm font-medium text-gray-900 whitespace-normal">
                  Getting Started with a Local Group
                </div>
              </td>
              <td class="px-6 py-4">
                <div class="text-sm text-gray-700">
                  A guide to establishing and organizing local groups focused on
                  religious freedom.
                </div>
              </td>
              <td class="px-6 py-4">
                <a
                  href="/docs/getting+started+with+a+local+group.pdf"
                  target="_blank"
                  class="block hover:opacity-75 transition-opacity">
                  <img
                    src="/docs/thumbnails/getting-started-thumb.jpg"
                    alt="Preview of Getting Started Guide - Click to Download PDF"
                    class="w-20 h-auto object-contain rounded shadow-sm"
                  />
                </a>
              </td>
            </tr>
            <tr>
              <td class="px-6 py-4 whitespace-nowrap">
                <div
                  class="text-sm font-medium text-gray-900 whitespace-normal">
                  Business Cards Front
                </div>
              </td>
              <td class="px-6 py-4">
                <div class="text-sm text-gray-700 whitespace-normal">
                  These are the front sides of business cards that you can hand
                  out with a QR code on the back and the logo on the front.
                  These are Microsoft Word documents that you can use with Avery
                  labels 5877.
                </div>
              </td>
              <td class="px-6 py-4">
                <a
                  href="/docs/business+cards+front.docx"
                  target="_blank"
                  class="block hover:opacity-75 transition-opacity">
                  <img
                    src="/docs/thumbnails/business-cards-front-thumb.jpg"
                    alt="Preview of Business Cards Front - Click to Download DOCX"
                    class="w-20 h-auto object-contain rounded shadow-sm"
                  />
                </a>
              </td>
            </tr>
            <tr>
              <td class="px-6 py-4 whitespace-nowrap">
                <div
                  class="text-sm font-medium text-gray-900 whitespace-normal">
                  Business Cards Back
                </div>
              </td>
              <td class="px-6 py-4">
                <div class="text-sm text-gray-700 whitespace-normal">
                  These are the back sides of business cards that you can hand
                  out with a QR code on the back and the logo on the front.
                  These are Microsoft Word documents that you can use with Avery
                  labels 5877.
                </div>
              </td>
              <td class="px-6 py-4">
                <a
                  href="/docs/business+cards+back.docx"
                  target="_blank"
                  class="block hover:opacity-75 transition-opacity">
                  <img
                    src="/docs/thumbnails/business-cards-back-thumb.jpg"
                    alt="Preview of Business Cards Back - Click to Download DOCX"
                    class="w-20 h-auto object-contain rounded shadow-sm"
                  />
                </a>
              </td>
            </tr>
            <tr>
              <td class="px-6 py-4 whitespace-nowrap">
                <div
                  class="text-sm font-medium text-gray-900 whitespace-normal">
                  Poster 8.5" x 11" Landscape
                </div>
              </td>
              <td class="px-6 py-4">
                <div class="text-sm text-gray-700 whitespace-normal">
                  Poster for demonstrations, etc. Microsoft Word document 8 1/2"
                  x 11" landscape orientation.
                </div>
              </td>
              <td class="px-6 py-4">
                <a
                  href="/docs/poster8.5x11_landscape.docx"
                  target="_blank"
                  class="block hover:opacity-75 transition-opacity">
                  <img
                    src="/docs/thumbnails/poster-8.5x11-landscape-thumb.jpg"
                    alt="Preview of 8.5x11 Landscape Poster - Click to Download DOCX"
                    class="w-20 h-auto object-contain rounded shadow-sm"
                  />
                </a>
              </td>
            </tr>
            <tr>
              <td class="px-6 py-4 whitespace-nowrap">
                <div
                  class="text-sm font-medium text-gray-900 whitespace-normal">
                  Poster 16" x 20" Portrait
                </div>
              </td>
              <td class="px-6 py-4">
                <div class="text-sm text-gray-700 whitespace-normal">
                  Poster for demonstrations, etc. Image is in PNG format 16" x
                  20" in portrait orientation. You can order prints online at
                  Office Depot, laminated, for about $25 each.
                </div>
              </td>
              <td class="px-6 py-4">
                <a
                  href="/docs/poster_portrait16x20.png"
                  target="_blank"
                  class="block hover:opacity-75 transition-opacity">
                  <img
                    src="/docs/thumbnails/poster-16x20-portrait-thumb.jpg"
                    alt="Preview of 16x20 Portrait Poster - Click to Download PNG"
                    class="w-20 h-auto object-contain rounded shadow-sm"
                  />
                </a>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </article>
  </Container>
</Layout>

<style>
  .bg-primary-dark {
    background-color: #1a5c36; /* A slightly darker shade of your primary color */
  }
</style>
