---
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
---

<Layout title="Documents">
  <Container>
    <div class="max-w-4xl mx-auto py-12 px-4">
      <h1 class="text-3xl font-bold text-primary mb-8">Documents</h1>

      <div class="bg-white rounded-lg shadow-md overflow-hidden">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th
                scope="col"
                class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                Title
              </th>
              <th
                scope="col"
                class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                Description
              </th>
              <th
                scope="col"
                class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                Download
              </th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <tr>
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="text-sm font-medium text-gray-900">
                  What is Christian Nationalism?
                </div>
              </td>
              <td class="px-6 py-4">
                <div class="text-sm text-gray-700">
                  An introduction to Christian nationalism and its impact on
                  religious freedom.
                </div>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <a
                  href="/docs/what+is+christian+nationalism.pdf"
                  target="_blank"
                  class="text-primary hover:text-primary-dark flex items-center">
                  <svg
                    class="w-5 h-5 mr-2"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24">
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"
                    ></path>
                  </svg>
                  Download PDF
                </a>
              </td>
            </tr>
            <tr>
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="text-sm font-medium text-gray-900">
                  Getting Started with a Local Group
                </div>
              </td>
              <td class="px-6 py-4">
                <div class="text-sm text-gray-700">
                  A guide to establishing and organizing local groups focused on
                  religious freedom.
                </div>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <a
                  href="/docs/getting+started+with+a+local+group.pdf"
                  target="_blank"
                  class="text-primary hover:text-primary-dark flex items-center">
                  <svg
                    class="w-5 h-5 mr-2"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24">
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"
                    ></path>
                  </svg>
                  Download PDF
                </a>
              </td>
            </tr>
            <tr>
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="text-sm font-medium text-gray-900">
                  Business Cards Front
                </div>
              </td>
              <td class="px-6 py-4">
                <div class="text-sm text-gray-700 whitespace-normal">
                  These are the front sides of business cards that you can hand
                  out with a QR code on the back and the logo on the front.
                  These are Microsoft Word documents that you can use with Avery
                  labels 5877.
                </div>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <a
                  href="/docs/business+cards+front.docx"
                  target="_blank"
                  class="text-primary hover:text-primary-dark flex items-center">
                  <svg
                    class="w-5 h-5 mr-2"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24">
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"
                    ></path>
                  </svg>
                  Download DOCX
                </a>
              </td>
            </tr>
            <tr>
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="text-sm font-medium text-gray-900">
                  Business Cards Back
                </div>
              </td>
              <td class="px-6 py-4">
                <div class="text-sm text-gray-700 whitespace-normal">
                  These are the back sides of business cards that you can hand
                  out with a QR code on the back and the logo on the front.
                  These are Microsoft Word documents that you can use with Avery
                  labels 5877.
                </div>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <a
                  href="/docs/business+cards+back.docx"
                  target="_blank"
                  class="text-primary hover:text-primary-dark flex items-center">
                  <svg
                    class="w-5 h-5 mr-2"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24">
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"
                    ></path>
                  </svg>
                  Download DOCX
                </a>
              </td>
            </tr>
            <tr>
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="text-sm font-medium text-gray-900">
                  Poster 8.5" x 11" Landscape
                </div>
              </td>
              <td class="px-6 py-4">
                <div class="text-sm text-gray-700 whitespace-normal">
                  Poster for demonstrations, etc. Microsoft Word document 8 1/2"
                  x 11" landscape orientation.
                </div>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <a
                  href="/docs/poster8.5x11_landscape.docx"
                  target="_blank"
                  class="text-primary hover:text-primary-dark flex items-center">
                  <svg
                    class="w-5 h-5 mr-2"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24">
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"
                    ></path>
                  </svg>
                  Download DOCX
                </a>
              </td>
            </tr>
            <tr>
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="text-sm font-medium text-gray-900">
                  Poster 16" x 20" Portrait 
                </div>
              </td>
              <td class="px-6 py-4">
                <div class="text-sm text-gray-700 whitespace-normal">
                  Poster for demonstrations, etc. Image is in PNG format 16" x 20" in portrait orientation. You can order prints online at Office Depot, laminated, for about $25 each.
                </div>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <a
                  href="/docs/poster_portrait16x20.png"
                  target="_blank"
                  class="text-primary hover:text-primary-dark flex items-center">
                  <svg
                    class="w-5 h-5 mr-2"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24">
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"
                    ></path>
                  </svg>
                  Download PNG
                </a>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </Container>
</Layout>

<style>
  .bg-primary-dark {
    background-color: #1a5c36; /* A slightly darker shade of your primary color */
  }
</style>
