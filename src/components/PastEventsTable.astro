---
interface PastEvent {
  title: string;
  date: string;
  time: string;
  description?: string;
  location?: string;
}

interface Props {
  pastEvents: PastEvent[];
}

const { pastEvents } = Astro.props;

function formatEventDate(dateString: string) {
  const [year, month, day] = dateString.split('-').map(Number);
  const date = new Date(year, month - 1, day);
  const dayNames = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
  const monthNames = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
  return {
    dayName: dayNames[date.getDay()],
    dayNumber: date.getDate(),
    month: monthNames[date.getMonth()],
    year: date.getFullYear(),
  };
}

const ISO_DATE = /^\d{4}-\d{2}-\d{2}$/;

const processedEvents = pastEvents.map((event) => {
  const isISODate = ISO_DATE.test(event.date);
  let dateLabel: string = event.date;
  if (isISODate) {
    const d = formatEventDate(event.date);
    dateLabel = `${d.dayName}, ${d.month} ${d.dayNumber}, ${d.year}`;
  }
  return { ...event, isISODate, dateLabel };
});
---

<div class="bg-white rounded-lg shadow-md mt-4">
  <div class="overflow-x-auto w-full">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th
            scope="col"
            class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
            Date
          </th>
          <th
            scope="col"
            class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
            Title
          </th>
          <th
            scope="col"
            class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
            Description
          </th>
          <th
            scope="col"
            class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
            Time / Location
          </th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        {processedEvents.map((event) => (
          <tr>
            <td class="px-4 py-2 text-sm text-gray-900">
              {event.isISODate ? (
                <time datetime={event.date}>{event.dateLabel}</time>
              ) : (
                <span>{event.dateLabel}</span>
              )}
            </td>
            <td class="px-4 py-2 text-sm text-gray-900">{event.title}</td>
            <td class="px-4 py-2 text-sm text-gray-900">{event.description}</td>
            <td class="px-4 py-2 text-sm text-gray-900">
              <time>{event.time}</time>
              {event.location && <br />}
              {event.location && <span class="text-gray-600">{event.location}</span>}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</div>
