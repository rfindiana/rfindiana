---
// No imports needed in the frontmatter
---

<footer class="bg-white text-text py-4 px-6 border-t">
  <div
    class="max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between gap-4 md:gap-6">
    {/* Left side: Logo and Copyright */}
    <div class="flex items-center gap-3">
      <a href="/">
        <img
          src="/images/logo.jpg"
          alt="Religious Freedom Indiana Logo"
          class="h-12 w-auto"
        />
      </a>
      <p class="text-sm text-text-light">
        © 2025 Religious Freedom Indiana. All rights reserved.
      </p>
      <p class="text-[8px] text-gray-300">
        Build: <span id="build-version"
          >{import.meta.env.PUBLIC_BUILD_VERSION || "dev"}</span
        >
      </p>
    </div>

    {/* Right side: Links and Button */}
    <div
      class="text-sm text-text-light flex flex-col sm:flex-row items-center gap-4">
      {/* Standard Footer Links */}
      <a href="/about" class="hover:text-primary transition">About</a>
      <a href="/contactform" class="hover:text-primary transition">Contact Us</a
      >
      <a href="/privacy" class="hover:text-primary transition">Privacy Policy</a
      >
      {/* Join Us Button */}
      <a
        href="/joinus"
        data-astro-reload
        class="bg-green-600 hover:bg-green-700 text-white text-sm font-bold py-1.5 px-3 rounded transition duration-300 ease-in-out">
        Join Us
      </a>
    </div>
  </div>
</footer>

<script>
  // Declare Day.js types
  declare const dayjs: any;
  declare const dayjs_plugin_utc: any;
  declare const dayjs_plugin_timezone: any;

  // Load Day.js and its plugins
  import("https://cdn.jsdelivr.net/npm/dayjs@1/dayjs.min.js")
    .then(() => import("https://cdn.jsdelivr.net/npm/dayjs@1/plugin/utc.js"))
    .then(
      () => import("https://cdn.jsdelivr.net/npm/dayjs@1/plugin/timezone.js")
    )
    .then(() => {
      const buildVersionElement = document.getElementById("build-version");
      if (!buildVersionElement) return;

      const buildVersion = buildVersionElement.textContent;
      if (!buildVersion || buildVersion === "dev") return;

      // Extract the date part from the build version (format: YYYY-MM-DD HH:mmUTC-XXXX)
      const dateMatch = buildVersion.match(/(\d{4}-\d{2}-\d{2} \d{2}:\d{2})/);
      if (dateMatch) {
        const utcDate = dateMatch[1];
        const easternTime = dayjs
          .utc(utcDate)
          .tz("America/New_York")
          .format("YYYY-MM-DD HH:mm");
        buildVersionElement.textContent = buildVersion.replace(
          utcDate,
          easternTime + " ET"
        );
      }
    })
    .catch((error) => {
      console.error("Error loading Day.js:", error);
    });
</script>
