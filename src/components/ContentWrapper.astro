---
interface Props {
  class?: string;
  as?: "article" | "div" | "section"; // allows changing the element type
  width?: "narrow" | "wide" | "full"; // allows different max-widths
}

const {
  class: className = "",
  as: Element = "article",
  width = "narrow",
} = Astro.props;

const widthClasses = {
  narrow: "max-w-3xl",
  wide: "max-w-4xl",
  full: "max-w-full",
};
---

<Element
  class={`${widthClasses[width]} mx-auto py-8 px-4 sm:px-6 lg:px-8 ${className}`}>
  <slot />
</Element>

