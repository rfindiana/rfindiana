---
// Import necessary components
import PageTitle from "@/components/PageTitle.astro";
---

<script is:inline>
  // Function to initialize or reload hero background image
  function initHeroBackground() {
    const heroBackground = document.querySelector(".hero-background");
    if (heroBackground) {
      // Skip if already loaded or loading
      if (
        heroBackground.classList.contains("loaded") ||
        heroBackground.dataset.loading === "true"
      ) {
        return;
      }

      // Mark as loading to prevent duplicate loading
      heroBackground.dataset.loading = "true";

      const imgUrl = "/images/optimized/hero-background.jpg";
      const img = new Image();
      img.onload = function () {
        heroBackground.style.backgroundImage = `url('${imgUrl}')`;
        heroBackground.classList.add("loaded");
        heroBackground.dataset.loading = "false";
      };
      img.src = imgUrl;
    }
  }

  // Initialize on first page load
  document.addEventListener("DOMContentLoaded", initHeroBackground);

  // Handle Astro View Transitions
  document.addEventListener("astro:page-load", initHeroBackground);

  // Re-initialize after a view transition completes
  document.addEventListener("astro:after-swap", initHeroBackground);
</script>

<div
  class="relative pt-24 pb-10 text-center mb-8 overflow-hidden min-h-screen flex flex-col justify-center">
  <div
    class="absolute inset-0 z-0 bg-cover bg-center hero-background transition-opacity duration-500"
    aria-hidden="true">
  </div>
  <div class="header-content container mx-auto px-4 relative z-10">
    <h1 class="text-4xl md:text-5xl font-bold mb-4 text-primary">
      Religious Freedom Indiana
    </h1>
    <p class="tagline text-xl md:text-2xl text-primary-dark mb-2">
      Hoosiers Working for Religious Freedom
    </p>
    <p
      class="micah-quote-hero italic text-lg md:text-xl text-primary-dark/90 mb-8">
      Act justly, love mercy, walk humbly (Micah 6:8)
    </p>

    <!-- Who We Are Section (replaces Vision) -->
    <div
      class="mx-auto max-w-3xl bg-white/40 backdrop-blur-sm p-6 rounded-lg shadow-lg mb-6 border border-white/20">
      <h2 class="text-2xl md:text-3xl font-bold text-primary mb-2">Who We Are</h2>
      <p class="text-lg text-gray-900 font-semibold">
        Religious Freedom Indiana (RFI) is a statewide coalition of Hoosiers who affirm that religious freedom is a right belonging to all, and that, in making and enforcing laws, government should not favor any interpretation based on one religious belief. RFI was founded in April 2025 to educate about and to firmly but non-violently oppose Christian nationalism and other extremist beliefs that conflate religion and democracy.
      </p>
    </div>

    <!-- Where We're Headed Section (replaces Mission) -->
    <div
      class="mx-auto max-w-3xl bg-white/40 backdrop-blur-sm p-6 rounded-lg shadow-lg border border-white/20">
      <h2 class="text-2xl md:text-3xl font-bold text-primary mb-2">Where We’re Headed</h2>
      <p class="text-lg text-gray-900 font-semibold mb-4">
        We envision a state and a nation governed by law without regard to religious beliefs, where every individual can freely worship, doubt, or disbelieve without facing fear, stigma, or coercion; where no government action favors one religion over others; and where all contribute to the common good.
      </p>
    </div>
  </div>
</div>

<style>
  .hero-background {
    opacity: 0;
  }
  .hero-background.loaded {
    opacity: 0.35;
  }

  /* Responsive adjustments */
  @media (max-width: 768px) {
    .header-content {
      padding-top: 2rem;
      padding-bottom: 2rem;
    }
  }
</style>
