---
---

<section class="relative overflow-hidden bg-primary text-white">
  <div class="h-[7px] bg-crimson w-full"></div>
  <div class="absolute inset-0 opacity-20" aria-hidden="true">
    <div class="absolute left-[-5%] top-[-10%] h-64 w-64 rounded-full bg-gold blur-3xl"></div>
    <div class="absolute bottom-[-12%] right-[-4%] h-72 w-72 rounded-full bg-crimson blur-3xl"></div>
  </div>
  <div class="relative mx-auto flex max-w-5xl flex-col items-center px-4 pb-20 pt-36 text-center sm:px-6 lg:px-8">
    <img
      src="/images/Logo Narrow.jpg"
      alt="Religious Freedom Indiana logo"
      class="w-full max-w-[320px] rounded-sm shadow-2xl sm:max-w-[380px]"
    />
    <p class="font-hussar text-sm uppercase tracking-[0.45em] text-white/75">
      Resisting Christian Nationalism
    </p>
    <h1 class="mt-6 max-w-4xl font-hussar text-4xl uppercase leading-[1.05] text-white sm:text-5xl lg:text-6xl">
      Hoosiers Working for Religious Freedom
    </h1>
    <p class="mt-6 max-w-3xl text-lg leading-relaxed text-white/90 sm:text-xl">
      We organize Hoosiers to defend pluralism, oppose Christian nationalism,
      and protect the freedom to worship, doubt, or disbelieve without
      coercion.
    </p>
    <div class="mt-10 w-full max-w-3xl rounded-2xl border border-white/25 bg-white/12 px-6 py-6 shadow-2xl backdrop-blur-sm">
      <p class="font-hussar text-xl leading-snug text-white sm:text-2xl">
        Act justly, love mercy, walk humbly
      </p>
      <p class="mt-2 text-sm uppercase tracking-[0.35em] text-white/70">
        Micah 6:8
      </p>
    </div>
    <div class="mt-10 flex flex-col items-center gap-4 sm:flex-row">
      <a
        href="/joinus"
        data-astro-reload
        class="inline-flex items-center justify-center rounded-full bg-gold px-8 py-3 font-hussar text-lg text-black transition hover:bg-[#e1a21e]">
        Join Us
      </a>
      <a
        href="/about"
        class="inline-flex items-center justify-center rounded-full border border-white/35 px-8 py-3 font-hussar text-lg text-white transition hover:bg-white/10">
        Learn More
      </a>
    </div>
  </div>
</section>
