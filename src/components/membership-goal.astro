---
import PageTitle from "@/components/PageTitle.astro";
const currentMembers = 234;
const goal = 100000;
const percentage = ((currentMembers / goal) * 100).toFixed(2);
const lastUpdated = "July 17, 2025";
---

<section class="pt-8 border-t">
  <PageTitle title="Our Membership Goal" />
  <p class="text-lg text-gray-700 mb-6">
    Our goal is to connect with 100,000 Hoosiers
    <span class="text-sm text-gray-600">
      (approx. 3.4% of Indiana voters in the 2024 presidential election)
    </span>
    dedicated to protecting true religious freedom. Here's our progress:
  </p>

  <div class="bg-gray-50 rounded-lg p-6 mb-8">
    <h3 class="text-xl font-medium text-primary mb-4">Current Progress</h3>
    <div class="flex flex-col sm:flex-row justify-between items-baseline mb-4">
      <span class="text-lg font-semibold text-primary">
        {currentMembers.toLocaleString()} / {goal.toLocaleString()} Total Supporters
      </span>
      <span class="text-sm font-medium text-gray-600">
        {percentage}% towards our goal!
      </span>
    </div>
    <div class="w-full bg-gray-200 rounded-full h-4 overflow-hidden">
      <div
        class="bg-primary h-4 rounded-full transition-all duration-500"
        style={`width: ${percentage}%`}>
      </div>
    </div>
    <p class="text-xs text-gray-500 mt-2">Last updated: {lastUpdated}</p>
    <p class="text-sm text-gray-600 mt-4">
      Note: If you want to show your support but don't wish to receive regular
      emails, you can subscribe and then unsubscribe immediately after
      confirming your subscription.
    </p>
  </div>

  <div>
    <h3 class="text-xl font-medium text-primary mb-4">Growth History</h3>
    <div class="mb-8">
      <canvas id="growthChart"></canvas>
    </div>
    <div class="overflow-x-auto w-full">
      <table
        id="growthTable"
        class="min-w-full divide-y divide-gray-200 text-sm">
        <thead class="bg-gray-50">
          <tr>
            <th
              scope="col"
              class="px-4 py-2 text-left font-medium text-gray-500 uppercase tracking-wider"
              >Date</th
            >
            <th
              scope="col"
              class="px-4 py-2 text-left font-medium text-gray-500 uppercase tracking-wider"
              >Total Supporters</th
            >
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <tr>
            <td class="px-4 py-2 whitespace-nowrap text-gray-900"
              >July 17, 2025</td
            >
            <td class="px-4 py-2 whitespace-nowrap text-gray-900">234</td>
          </tr>
          <tr>
            <td class="px-4 py-2 whitespace-nowrap text-gray-900"
              >July 3, 2025</td
            >
            <td class="px-4 py-2 whitespace-nowrap text-gray-900">184</td>
          </tr>
          <tr>
            <td class="px-4 py-2 whitespace-nowrap text-gray-900"
              >June 16, 2025</td
            >
            <td class="px-4 py-2 whitespace-nowrap text-gray-900">156</td>
          </tr>
          <tr>
            <td class="px-4 py-2 whitespace-nowrap text-gray-900"
              >May 16, 2025</td
            >
            <td class="px-4 py-2 whitespace-nowrap text-gray-900">90</td>
          </tr>
          <tr>
            <td class="px-4 py-2 whitespace-nowrap text-gray-900"
              >April 10, 2025</td
            >
            <td class="px-4 py-2 whitespace-nowrap text-gray-900">69</td>
          </tr>
          <tr>
            <td class="px-4 py-2 whitespace-nowrap text-gray-900"
              >March 27, 2025</td
            >
            <td class="px-4 py-2 whitespace-nowrap text-gray-900">28</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</section>

<script>
  import Chart from "chart.js/auto";

  function initializeChart() {
    const table = document.getElementById("growthTable");
    if (!table) return;
    const tbody = table.getElementsByTagName("tbody")[0];
    if (!tbody) return;
    const rows = tbody.getElementsByTagName("tr");
    const labels = [];
    const data = [];
    for (let i = 0; i < rows.length; i++) {
      const cells = rows[i].getElementsByTagName("td");
      if (cells.length >= 2) {
        labels.push(cells[0].innerText);
        data.push(parseInt(cells[1].innerText));
      }
    }
    // Reverse arrays to show from earliest to latest
    labels.reverse();
    data.reverse();
    const canvas = document.getElementById("growthChart");
    if (!(canvas instanceof HTMLCanvasElement)) return;
    const existingChart = Chart.getChart(canvas);
    if (existingChart) {
      existingChart.destroy();
    }
    const ctx = canvas.getContext("2d");
    if (ctx) {
      new Chart(ctx, {
        type: "line",
        data: {
          labels: labels,
          datasets: [
            {
              label: "Total Supporters",
              data: data,
              borderColor: "rgb(79, 70, 229)",
              tension: 0.1,
            },
          ],
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          scales: {
            y: {
              beginAtZero: true,
            },
          },
        },
      });
    }
  }
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initializeChart);
  } else {
    initializeChart();
  }
  document.addEventListener("astro:page-load", initializeChart);
</script>
