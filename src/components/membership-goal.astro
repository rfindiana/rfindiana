<section class="pt-8 border-t">
  <div class="mb-8">
    <h2 class="text-3xl font-bold text-primary">Growth History</h2>
  </div>
  <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.35fr)] lg:items-start">
    <div class="overflow-x-auto w-full">
      <table
        id="growthTable"
        class="min-w-full divide-y divide-gray-200 text-sm">
        <thead class="bg-gray-50">
          <tr>
            <th
              scope="col"
              class="px-4 py-2 text-left font-medium text-gray-500 uppercase tracking-wider"
              >Date</th
            >
            <th
              scope="col"
              class="px-4 py-2 text-left font-medium text-gray-500 uppercase tracking-wider"
              >Total Supporters</th
            >
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <tr>
            <td class="px-4 py-2 whitespace-nowrap text-gray-900"
              >April 23, 2026</td
            >
            <td class="px-4 py-2 whitespace-nowrap text-gray-900">509</td>
          </tr>
          <tr>
            <td class="px-4 py-2 whitespace-nowrap text-gray-900"
              >October 20, 2025</td
            >
            <td class="px-4 py-2 whitespace-nowrap text-gray-900">431</td>
          </tr>
          <tr>
            <td class="px-4 py-2 whitespace-nowrap text-gray-900"
              >August 5, 2025</td
            >
            <td class="px-4 py-2 whitespace-nowrap text-gray-900">269</td>
          </tr>
          <tr>
            <td class="px-4 py-2 whitespace-nowrap text-gray-900"
              >July 17, 2025</td
            >
            <td class="px-4 py-2 whitespace-nowrap text-gray-900">234</td>
          </tr>
          <tr>
            <td class="px-4 py-2 whitespace-nowrap text-gray-900"
              >July 3, 2025</td
            >
            <td class="px-4 py-2 whitespace-nowrap text-gray-900">184</td>
          </tr>
          <tr>
            <td class="px-4 py-2 whitespace-nowrap text-gray-900"
              >June 16, 2025</td
            >
            <td class="px-4 py-2 whitespace-nowrap text-gray-900">156</td>
          </tr>
          <tr>
            <td class="px-4 py-2 whitespace-nowrap text-gray-900"
              >May 16, 2025</td
            >
            <td class="px-4 py-2 whitespace-nowrap text-gray-900">90</td>
          </tr>
          <tr>
            <td class="px-4 py-2 whitespace-nowrap text-gray-900"
              >April 10, 2025</td
            >
            <td class="px-4 py-2 whitespace-nowrap text-gray-900">69</td>
          </tr>
          <tr>
            <td class="px-4 py-2 whitespace-nowrap text-gray-900"
              >March 27, 2025</td
            >
            <td class="px-4 py-2 whitespace-nowrap text-gray-900">28</td>
          </tr>
        </tbody>
      </table>
    </div>
    <div class="bg-white rounded-lg border border-gray-200 p-4">
      <div class="h-[320px] sm:h-[380px]">
        <canvas id="growthChart"></canvas>
      </div>
    </div>
  </div>
</section>

<script>
  import Chart from "chart.js/auto";

  function initializeChart() {
    const table = document.getElementById("growthTable");
    if (!table) return;
    const tbody = table.getElementsByTagName("tbody")[0];
    if (!tbody) return;
    const rows = tbody.getElementsByTagName("tr");
    const labels = [];
    const data = [];
    for (let i = 0; i < rows.length; i++) {
      const cells = rows[i].getElementsByTagName("td");
      if (cells.length >= 2) {
        labels.push(cells[0].innerText);
        data.push(parseInt(cells[1].innerText));
      }
    }
    // Reverse arrays to show from earliest to latest
    labels.reverse();
    data.reverse();
    const canvas = document.getElementById("growthChart");
    if (!(canvas instanceof HTMLCanvasElement)) return;
    const existingChart = Chart.getChart(canvas);
    if (existingChart) {
      existingChart.destroy();
    }
    const ctx = canvas.getContext("2d");
    if (ctx) {
      new Chart(ctx, {
        type: "line",
        data: {
          labels: labels,
          datasets: [
            {
              label: "Total Supporters",
              data: data,
              borderColor: "rgb(79, 70, 229)",
              tension: 0.1,
            },
          ],
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          scales: {
            y: {
              beginAtZero: true,
            },
          },
        },
      });
    }
  }
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initializeChart);
  } else {
    initializeChart();
  }
  document.addEventListener("astro:page-load", initializeChart);
</script>
