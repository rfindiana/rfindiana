---
interface Props {
  class?: string;
  article?: boolean;
}

const { class: className, article = false } = Astro.props;
---

<div class:list={["max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8 w-full", className]}>
  {
    article ? (
      <article class="max-w-5xl mx-auto py-8">
        <slot />
      </article>
    ) : (
      <slot />
    )
  }
</div>
