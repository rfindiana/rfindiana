---
export interface ProtestInfo {
  imagePath: string;
  imageAlt: string;
  description: string[];
}

export interface Props {
  protestInfo?: ProtestInfo;
  sectionTitle?: string;
}

const { 
  sectionTitle = "Help with protests",
  protestInfo
} = Astro.props;

const defaultProtestInfo: ProtestInfo = {
  imagePath: import.meta.env.DEV ? "/email-preview/images/ProtestGoodTrouble.jpg" : "https://rfindiana.org/email-preview/images/ProtestGoodTrouble.jpg",
  imageAlt: "Religious Freedom Indiana booth at protest event with volunteers",
  description: [
    "Religious Freedom Indiana continues to show up at Indiana advocacy events, for two reasons:",
    "• We advocate for freedom of religion for all, and for the separation of church and state;",
    "• We want folks to know they can join with like-minded people to work together to confront Christian nationalist ideology.",
    "We'd love to have you join us, whether you can help once or more frequently. Below is our new tent, purchased with the help of donors (second booth from right). Your job would be to stand by the booth and visit with folks about the mission of Religious Freedom Indiana. Contact <strong><a href=\"mailto:dale.brubaker@rfindiana.org\" style=\"color: #0066cc; text-decoration: underline;\">dale.brubaker@rfindiana.org</a></strong> to volunteer."
  ]
};

const displayProtestInfo = protestInfo || defaultProtestInfo;
---

<div>
  <h2 style="font-family: Arial, sans-serif; font-size: 30px; margin-top: 24px; margin-bottom: 10px;">
    {sectionTitle}
  </h2>

  {displayProtestInfo.description.map((paragraph) => (
    <p style="font-family: Arial, sans-serif; font-size: 18px; line-height: 1.6; margin-bottom: 16px;" set:html={paragraph}></p>
  ))}

  <div style="text-align: center; margin-bottom: 16px;">
    <img 
      src={displayProtestInfo.imagePath} 
      alt={displayProtestInfo.imageAlt} 
      style="max-width: 400px; height: auto; border: none; display: block; margin: 0 auto;"
    />
  </div>
  
  <hr style="border: none; border-top: 1px solid #000; margin: 20px 0;" />
</div>