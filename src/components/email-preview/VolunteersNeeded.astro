---
export interface VolunteerInfo {
  title: string;
  description: string[];
  contactEmail: string;
  positions: string[];
}

export interface Props {
  volunteer?: VolunteerInfo;
}

const { volunteer } = Astro.props;

const defaultVolunteer: VolunteerInfo = {
  title: "Volunteers needed!",
  description: [
    "Religious Freedom Indiana can use you! As a fast-growing organization, we have more tasks to complete than we have people for. If you have a little time, the inclination to serve, and some rudimentary web skills, we'd love to have your help for these volunteer positions. Contact vivian.combs@rfindiana.org",
    "Social media coordinator – Someone to create, collect, and curate content for our Facebook page (<a href=\"https://www.facebook.com/groups/1436924083969818\" style=\"color: #0066cc;\">Religious Freedom Indiana | Facebook</a>) and Instagram page.",
    "News coordinator – Someone to identify news stories related to religious liberty and post them in the weekly newsletter."
  ],
  contactEmail: "vivian.combs@rfindiana.org",
  positions: []
};

const displayVolunteer = volunteer || defaultVolunteer;
---

<div>
  <h2 style="font-family: Arial, sans-serif; font-size: 30px; margin-top: 24px; margin-bottom: 10px;">
    {displayVolunteer.title}
  </h2>

  {displayVolunteer.description.map((paragraph) => (
    <p style="font-family: Arial, sans-serif; font-size: 18px; line-height: 1.6; margin-bottom: 16px;" set:html={paragraph}></p>
  ))}
  
  <hr style="border: none; border-top: 1px solid #000; margin: 20px 0;" />
</div>