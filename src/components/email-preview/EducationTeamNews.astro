---
export interface EducationNews {
  title: string;
  content: string;
  videoLink: string;
}

export interface Props {
  news?: EducationNews;
}

const { news } = Astro.props;

const defaultNews: EducationNews = {
  title: "Education Team News",
  content: "Do you sometimes think you are reading a different Bible? An article in Baptist News Global explains ten of the Bible verses Christian nationalists wield to prove they should be in power.",
  videoLink: "https://baptistnews.com/article/10-bible-verses-christian-nationalists-take-out-of-context-to-sieze-power/"
};

const displayNews = news || defaultNews;
---

<div>
  <h2 style="font-family: Arial, sans-serif; font-size: 30px; margin-top: 24px; margin-bottom: 10px;">
    {displayNews.title}
  </h2>

  <p style="font-family: Arial, sans-serif; font-size: 18px; line-height: 1.6; margin-bottom: 8px;">
    {displayNews.content}
  </p>
  
  <p style="font-family: Arial, sans-serif; font-size: 18px; line-height: 1.6; margin-bottom: 16px;">
    <a href={displayNews.videoLink} style="color: #0066cc;">10 Bible verses Christian nationalists take out of context</a>
  </p>
  
  <hr style="border: none; border-top: 1px solid #000; margin: 20px 0;" />
</div>