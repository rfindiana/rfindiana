---
export interface NewsItem {
  title: string;
  content: string;
  articleTitle: string;
  articleLink?: string;
}

export interface Props {
  news?: NewsItem;
}

const { news } = Astro.props;

const defaultNews: NewsItem = {
  title: "In the news this week",
  content: "A Tennessee news station reported this week about their deep investigation into development plans in a Tennessee county funded by Christian nationalist backers. The report revealed that the developers bought thousands of acres with the purpose of building a new community following Christian nationalist principles, with the stated objective of taking over the locality and re-fashioning a new society. See the chilling video here:",
  articleTitle: "Meet the out-of-state investors funding a Christian nationalist community in Tennessee",
  articleLink: "https://www.youtube.com/watch?v=xxP34ORMiZU"
};

const displayNews = news || defaultNews;
---

<div>
  <h2 style="font-family: Arial, sans-serif; font-size: 30px; margin-top: 24px; margin-bottom: 10px;">
    {displayNews.title}
  </h2>

  <p style="font-family: Arial, sans-serif; font-size: 18px; line-height: 1.6; margin-bottom: 12px;" set:html={displayNews.content}>
  </p>
  
  {displayNews.articleLink ? (
    <p style="font-family: Arial, sans-serif; font-size: 18px; line-height: 1.6; margin-bottom: 16px;">
      <a href={displayNews.articleLink} style="color: #0066cc;">{displayNews.articleTitle}</a>
    </p>
  ) : (
    <p style="font-family: Arial, sans-serif; font-size: 18px; line-height: 1.6; margin-bottom: 16px;">
      {displayNews.articleTitle}
    </p>
  )}
  
  <hr style="border: none; border-top: 1px solid #000; margin: 20px 0;" />
</div>