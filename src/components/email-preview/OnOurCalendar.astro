---
export interface Event {
  title: string;
  subtitle?: string;
  host: string;
  description: string;
  email?: string;
  registrationUrl?: string;
  nextSession: string;
  time: string;
}


export interface Props {
  events?: Event[];
  eventsPageUrl?: string;
}

const { 
  events = [],
  eventsPageUrl = "https://www.rfindiana.org/events/"
} = Astro.props;

const defaultEvents: Event[] = [
  {
    title: "How to End Christian Nationalism",
    subtitle: "(face-to-face version)",
    host: "Dr. Steve Ivy",
    description: "Once-monthly book study meets at First Baptist Church of Indianapolis, 8600 N. College Ave. Also led by Steve Ivy.",
    email: "Steven.ivy@rfindiana.org",
    nextSession: "Tues. Aug. 12",
    time: "7:00 pm ET"
  },
  {
    title: "How to End Christian Nationalism",
    host: "Dr. Steve Ivy",
    description: "Dr. Steve Ivy facilitates this book study. Steve is Baptist clergy, a retired hospital chaplain, and seminary professor. For further information regarding the study, contact him at Steven.ivy@rfindiana.org.",
    email: "Steven.ivy@rfindiana.org",
    registrationUrl: "https://www.rfindiana.org/events/",
    nextSession: "Aug. 26",
    time: "Monthly on fourth Tuesday, 7:00 PM ET"
  }
];

const displayEvents = events.length > 0 ? events : defaultEvents;
---

<div>
  <h2 style="font-family: Arial, sans-serif; font-size: 30px; margin-bottom: 0px;">On our calendar</h2>
  
  <table width="550" cellpadding="10" cellspacing="0" border="0" style="font-family: Arial, sans-serif; color: #000000; border-collapse: collapse; width: 550px;">
    <tr>
      <th align="left" style="border-bottom: 2px solid #cccccc; font-size: 16px; width: 160px;">Title</th>
      <th align="left" style="border-bottom: 2px solid #cccccc; font-size: 16px; width: 280px;">Description</th>
      <th align="left" style="border-bottom: 2px solid #cccccc; font-size: 16px; width: 160px;">Host & Times</th>
    </tr>
    
    {displayEvents.map((event) => (
      <tr>
        <td valign="top" style="font-size: 18px;">
          <strong>{event.title}</strong>
          {event.subtitle && (
            <Fragment>
              <br />
              {event.subtitle}
            </Fragment>
          )}
        </td>
        <td valign="top" style="font-size: 18px;">
          {event.description}
          {event.email && (
            <Fragment>
              For further information, contact Ivy at    
              <a href={`mailto:${event.email}`} style="color: #0066cc;">{event.email}</a>
            </Fragment>
          )}
          <br /><br />
          {event.registrationUrl && (
            <strong>
              <a href={event.registrationUrl} style="color: #0066cc; text-decoration: underline;">
                {event.title === "August Prayer Watch" ? "Sign up at this link" : `Register for ${event.title}`}
              </a>
            </strong>
          )}
        </td>
        <td valign="top" style="font-size: 18px;">
          <strong>Host:</strong> {event.host}<br />
          <strong>Next session:</strong><br />
          {event.nextSession}<br />
          {event.time}
        </td>
      </tr>
    ))}
  </table>

  <p style="font-family: Arial, sans-serif; font-size: 16px; padding-top: 16px;">
    Check out our Events page at 
    <a href={eventsPageUrl} style="color: #0066cc; text-decoration: underline;">{eventsPageUrl}</a> for more information.
  </p>
  
  <hr style="border: none; border-top: 1px solid #000; margin: 20px 0;" />
</div>