---
interface Meeting {
  title: string;
  host: string;
  description: string;
  times: string;
  registrationLink?: string;
}

interface Props {
  meetings: Meeting[];
  hostColumnTitle?: string;
}

const { meetings, hostColumnTitle = "Host" } = Astro.props;
---

<div class="bg-white rounded-lg shadow-md mt-4">
  <div class="overflow-x-auto w-full">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th
            scope="col"
            class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
            Title
          </th>
          <th
            scope="col"
            class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
            {hostColumnTitle}
          </th>
          <th
            scope="col"
            class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
            Description
          </th>
          <th
            scope="col"
            class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
            Time(s)
          </th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        {meetings.map(meeting => (
          <tr>
            <td class="px-4 py-2 text-sm text-gray-900">{meeting.title}</td>
            <td class="px-4 py-2 text-sm text-gray-900">{meeting.host}</td>
            <td class="px-4 py-2 text-sm text-gray-900">
              {meeting.description}
              {meeting.registrationLink && (
                <>
                  <br />
                  <a
                    href={meeting.registrationLink}
                    class="text-primary underline hover:opacity-80"
                    target="_blank">Register for {meeting.title}</a>
                </>
              )}
            </td>
            <td class="px-4 py-2 text-sm text-gray-900">
              {meeting.times}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</div>