---
import Container from "@/components/container.astro";
import Dropdown from "./dropdown.astro";
import { Astronav, MenuItems, MenuIcon } from "astro-navbar";

const menuitems = [
  { title: "About", path: "/about" },
  { title: "Events", path: "/events" },
  { title: "Books", path: "/books" },
  { title: "Videos", path: "/videos" },
  { title: "Documents", path: "/documents" },
  { title: "Network", path: "/network" },
  { title: "Online Resources", path: "/onlineresources" },
  { title: "Contact Us", path: "/contactform" },
];

// Check if we're on the homepage
const isHomePage = Astro.url.pathname === "/";
---

<Container
  class={`fixed top-0 w-full z-50 ${isHomePage ? "bg-white/40 backdrop-blur-sm shadow-sm" : "bg-white sticky"}`}>
  <header class="flex flex-col lg:flex-row justify-start items-center my-2">
    <Astronav>
      <div class="flex w-full lg:w-auto items-center justify-between">
        <a href="/" class="text-lg">
          <img
            src="/images/logo.svg"
            alt="Religious Freedom Indiana Logo"
            class={`h-16 w-auto max-w-[200px] sm:max-w-none ${isHomePage ? "drop-shadow-md" : ""}`}
          />
        </a>
        <div class="block lg:hidden">
          <MenuIcon class="w-4 h-4 text-text" />
        </div>
      </div>
      <!-- Add specific left margin for large screens -->
      <MenuItems class="hidden w-full lg:w-auto mt-2 lg:flex lg:mt-0 lg:ml-8">
        <ul class="flex flex-col lg:flex-row lg:gap-3">
          <li class="mt-2 lg:mt-0 lg:mr-3">
            <a
              href="/joinus"
              data-astro-reload
              class="bg-green-600 hover:bg-green-700 text-white font-bold py-2 px-4 rounded shadow-md transition duration-300 ease-in-out block text-center lg:inline-block">
              Join Us
            </a>
          </li>
          {
            menuitems.map((item) => {
              const isBasePath = item.path === "/";
              const isActive = isBasePath
                ? Astro.url.pathname === "/"
                : Astro.url.pathname.startsWith(item.path);

              // Define base classes
              const baseClasses = "flex lg:px-3 py-2 items-center";
              // Define active state classes for homepage vs other pages
              const activeStateClasses = isHomePage
                ? isActive
                  ? "font-bold text-primary"
                  : "text-text hover:text-primary"
                : isActive
                  ? "font-bold text-primary"
                  : "text-text hover:text-primary";

              return (
                <li>
                  <a
                    href={item.path}
                    class={`${baseClasses} ${activeStateClasses}`}>
                    <span> {item.title}</span>
                  </a>
                </li>
              );
            })
          }
        </ul>
      </MenuItems>
    </Astronav>
  </header>
</Container>
