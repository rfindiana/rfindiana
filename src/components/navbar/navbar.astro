---
import Container from "@/components/container.astro";
import Dropdown from "./dropdown.astro";
import { Astronav, MenuItems, MenuIcon } from "astro-navbar";

const menuitems = [
  { title: "About", path: "/about" },
  { title: "Contact Us", path: "/contactform" },
  { title: "Join Us 2", path: "/joinus2" },
  { title: "MailerLite Form", path: "/mailerlite-form" },
];
---

<Container class="sticky top-0 z-50 bg-white">
  <header
    class="flex flex-col lg:flex-row justify-between items-center mt-5 mb-2">
    <div class="flex items-center">
      <a href="/" class="text-lg mr-8">
        <img
          src="/images/logo.jpg"
          alt="Religious Freedom Indiana Logo"
          class="h-16 w-auto"
        />
      </a>
      <Astronav>
        <div class="flex w-full lg:w-auto items-center justify-between">
          <div class="block lg:hidden ml-auto">
            <MenuIcon class="w-4 h-4 text-text" />
          </div>
        </div>
        <MenuItems class="w-full lg:w-auto mt-2 lg:flex lg:mt-0">
          <ul class="flex flex-col lg:flex-row lg:items-center lg:gap-3">
            {
              menuitems.map((item) => {
                const isBasePath = item.path === "/";
                const isActive = isBasePath
                  ? Astro.url.pathname === "/"
                  : Astro.url.pathname.startsWith(item.path);

                // Define base classes
                const baseClasses = "flex lg:px-3 py-2 items-center";
                // Define active state classes
                const activeStateClasses = isActive
                  ? "font-bold text-primary"
                  : "text-text hover:text-primary"; // Apply hover only if inactive

                return (
                  <li>
                    <a
                      href={item.path}
                      class={`${baseClasses} ${activeStateClasses}`}>
                      <span> {item.title}</span>
                    </a>
                  </li>
                );
              })
            }
            <li class="mt-2 lg:mt-0 lg:ml-3">
              <a
                href="/joinus"
                data-astro-reload
                class="bg-green-600 hover:bg-green-700 text-white font-bold py-2 px-4 rounded transition duration-300 ease-in-out block text-center lg:inline-block">
                Join Us
              </a>
            </li>
          </ul>
        </MenuItems>
      </Astronav>
    </div>
  </header>
</Container>
