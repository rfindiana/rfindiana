---
import Container from "@/components/container.astro";
import { Astronav, MenuItems, MenuIcon } from "astro-navbar";

const menuitems = [
  { title: "About", path: "/about" },
  { title: "Events", path: "/events" },
  { title: "Updates", path: "/updates" },
  { title: "Books", path: "/books" },
  { title: "Videos", path: "/videos" },
  { title: "Documents", path: "/documents" },
  { title: "Network", path: "/network" },
  { title: "Online Resources", path: "/onlineresources" },
  { title: "Donate", path: "/donate" },
  { title: "Contact", path: "/contactform" },
];

// Check if we're on the homepage
const isHomePage = Astro.url.pathname === "/";
---

<Container
  class="fixed top-0 w-full z-50 bg-white shadow-sm">
  <header class="flex flex-col xl:flex-row justify-start items-center my-2">
    <Astronav>
      <div class="flex w-full xl:w-auto items-center justify-between">
        <a href="/" class="text-lg">
          <img
            src="/images/Logo Wide.png"
            alt="Religious Freedom Indiana Logo"
            width="600"
            height="200"
            fetchpriority="high"
            decoding="sync"
            class={`logo-img h-14 w-auto max-w-[250px] sm:max-w-none xl:h-16 ${isHomePage ? "drop-shadow-md" : ""}`}
          />
        </a>
        <div class="block xl:hidden">
          <MenuIcon class="w-4 h-4 text-text" />
        </div>
      </div>
      <MenuItems class="hidden w-full xl:ml-6 xl:mt-0 xl:flex xl:w-auto mt-2">
        <ul class="flex flex-col xl:flex-row xl:items-center xl:gap-1">
          <li class="mt-2 xl:mt-0 xl:mr-2">
            <a
              href="/joinus"
              data-astro-reload
              class="block rounded bg-green-600 px-4 py-2 text-center font-bold text-white shadow-md transition duration-300 ease-in-out hover:bg-green-700 xl:inline-block xl:px-3">
              Join Us
            </a>
          </li>
          {
            menuitems.map((item) => {
              const isBasePath = item.path === "/";
              const isActive = isBasePath
                ? Astro.url.pathname === "/"
                : Astro.url.pathname.startsWith(item.path);

              const baseClasses =
                "flex items-center py-2 xl:px-2 xl:text-sm 2xl:px-3 2xl:text-base";
              const activeStateClasses = isHomePage
                ? isActive
                  ? "font-bold text-primary"
                  : "text-text hover:text-primary"
                : isActive
                  ? "font-bold text-primary"
                  : "text-text hover:text-primary";

              return (
                <li>
                  <a
                    href={item.path}
                    class={`${baseClasses} ${activeStateClasses}`}>
                    <span> {item.title}</span>
                  </a>
                </li>
              );
            })
          }
        </ul>
      </MenuItems>
    </Astronav>
  </header>
</Container>
