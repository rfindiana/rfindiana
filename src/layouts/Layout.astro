---
import { SEO } from "astro-seo";
import Footer from "@/components/footer.astro";
import Navbar from "@/components/navbar/navbar.astro";
import Container from "@/components/container.astro";
import { SITE, SOCIAL } from "@/utils/constants";
import "@fontsource-variable/inter/index.css";
import "@fontsource-variable/bricolage-grotesque";
import "../styles/global.css";
import { ViewTransitions } from "astro:transitions";

/**
 * Props for the Layout component
 * @interface Props
 * @property {string} title - The page title. If it matches the site name, it will be used as is.
 *                           Otherwise, it will be combined with the site name using the template pattern.
 */
export interface Props {
  title: string;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();

const resolvedImageWithDomain = new URL(
  "/opengraph.jpg",
  Astro.site
).toString();

const { title } = Astro.props;

const makeTitle =
  title === SITE.name
    ? SITE.title.default
    : SITE.title.template.replace("%s", title);

// Get MailerLite account ID from environment variables
const mailerLiteAccountId = import.meta.env.MAILERLITE_ACCOUNT_ID || "1436469";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/images/favicon.png" />
    <meta name="generator" content={Astro.generator} />

    <!-- <link rel="preload" as="image" href={src} alt="Hero" /> -->
    <SEO
      title={makeTitle}
      description={SITE.description}
      canonical={canonicalURL}
      twitter={{
        creator: SOCIAL.twitter.creator,
        site: SOCIAL.twitter.site,
        card: SOCIAL.twitter.cardType,
      }}
      openGraph={{
        basic: {
          url: canonicalURL,
          type: "website",
          title: SITE.name,
          image: resolvedImageWithDomain,
        },
        image: {
          alt: SITE.name,
        },
      }}
    />
    <ViewTransitions />

   
  </head>
  <body>
    <Container>
      <Navbar />
    </Container>
    <slot />
    <Container>
      <Footer />
    </Container>

    

    <style is:global>
      /* Improve Page speed */
      /* https://css-tricks.com/almanac/properties/c/content-visibility/ */
      img {
        content-visibility: auto;
      }
    </style>
  </body>
</html>
