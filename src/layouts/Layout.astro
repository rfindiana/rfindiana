---
import { SEO } from "astro-seo";
import Footer from "@/components/footer.astro";
import Navbar from "@/components/navbar/navbar.astro";
import "@fontsource-variable/inter/index.css";
import "@fontsource-variable/bricolage-grotesque";
import "../styles/global.css";
import { ViewTransitions } from "astro:transitions";

export interface Props {
  title: string;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();

const resolvedImageWithDomain = new URL(
  "/opengraph.jpg",
  Astro.site
).toString();

const { title } = Astro.props;

const makeTitle =
  title === "Religious Freedom Indiana"
    ? "Religious Freedom Indiana"
    : title + " | " + "Religious Freedom Indiana";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/images/favicon.jpg" />
    <meta name="generator" content={Astro.generator} />

    <!-- <link rel="preload" as="image" href={src} alt="Hero" /> -->
    <SEO
      title={makeTitle}
      description="Religious Freedom Indiana - Hoosiers working for religious freedom."
      canonical={canonicalURL}
      twitter={{
        creator: "@surjithctly",
        site: "@web3templates",
        card: "summary_large_image",
      }}
      openGraph={{
        basic: {
          url: canonicalURL,
          type: "website",
          title: "Religious Freedom Indiana",
          image: resolvedImageWithDomain,
        },
        image: {
          alt: "Religious Freedom Indiana",
        },
      }}
    />
    <ViewTransitions />

    {/* MailerLite Universal */}
    <script is:inline>
      (function (w, d, e, u, f, l, n) {
        (w[f] =
          w[f] ||
          function () {
            (w[f].q = w[f].q || []).push(arguments);
          }),
          (l = d.createElement(e)),
          (l.async = 1),
          (l.src = u),
          (n = d.getElementsByTagName(e)[0]),
          n.parentNode.insertBefore(l, n);
      })(
        window,
        document,
        "script",
        "https://assets.mailerlite.com/js/universal.js",
        "ml"
      );
      ml("account", "1436469");
    </script>
    {/* End MailerLite Universal */}
  </head>
  <body>
    <Navbar />
    <slot />
    <Footer />

    <script>
      // Declare ml function to satisfy TypeScript/linter
      declare const ml: Function;

      // Re-initialize MailerLite forms after Astro View Transitions
      document.addEventListener("astro:after-swap", () => {
        console.log(
          "Astro swap finished. Attempting MailerLite form update..."
        ); // DEBUG
        if (typeof ml === "function") {
          console.log('ml function found. Calling ml("update")...'); // DEBUG
          try {
            // Try calling an update/re-scan command instead of account init
            ml("update");
            console.log("MailerLite update command called successfully."); // DEBUG
          } catch (error) {
            console.error('Error calling ml("update") command:', error); // DEBUG
          }
        } else {
          console.log("ml function NOT found at time of swap."); // DEBUG
        }
      });
    </script>

    <style is:global>
      /* Improve Page speed */
      /* https://css-tricks.com/almanac/properties/c/content-visibility/ */
      img {
        content-visibility: auto;
      }
    </style>
  </body>
</html>
