# Build Information
# Format: YYYY-MM-DD HH:MM ET-commit_sha
# This is automatically set in production by Cloudflare Pages
PUBLIC_BUILD_VERSION=2024-03-21 12:00 ET-local

# Site Configuration
# The base URL for your site (used in astro.config.mjs)
SITE_URL=http://localhost:4321

# MailerLite Configuration
# Your MailerLite account ID (currently hardcoded in Layout.astro)
MAILERLITE_ACCOUNT_ID=1436469

# Note: In production, these variables are set by Cloudflare Pages:
# CF_PAGES_COMMIT_SHA - The SHA of the commit being deployed
# CF_PAGES_URL - The URL of your Cloudflare Pages site 